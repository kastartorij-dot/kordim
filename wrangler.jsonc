{
  // Кордим — чисто статический сайт (Порт/site/app, старый справочник, картинки,
  // копия игры в Порт/site/game/), своего кода Worker'а нет. "assets" без "main"
  // говорит Wrangler просто отдавать файлы из папки как есть, без бэкенда —
  // это и есть аналог того, что раньше называлось Cloudflare Pages.
  "name": "kordim",
  "compatibility_date": "2026-09-16",
  "assets": {
    "directory": "./Порт/site"
  }
}
