{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Сайт",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "Игры/Сайт/_serve.ps1"
      ],
      "port": 8791
    },
    {
      "name": "Сайт-Python",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8791",
        "--directory",
        "Игры/Сайт"
      ],
      "port": 8791
    },
    {
      "name": "faces",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "Персонажи/_serve.py",
        "8793"
      ],
      "port": 8793
    },
    {
      "name": "repo-py",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8795"
      ],
      "port": 8795
    }
  ]
}
