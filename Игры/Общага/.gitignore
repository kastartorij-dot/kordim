# превью рендера — пересобираются скриптом
/shots/
# кэш Godot
.godot/
*.import
!models/общага.glb.import
# По умолчанию Godot извлекает встроенные изображения glTF рядом с моделью.
# У общага.glb настроено хранение внутри ресурса, старые извлечения — кэш.
/models/общага_*.jpg
/models/общага_*.png
# кэш Python
__pycache__/
/builds/
/референсы_локально/

# Полный исходник дерева ~100 MB; в игре используется оптимизированный GLB.
/assets/polyhaven/tree_small_02/

!models/дерево.glb.import
/models/дерево_*.jpg
/models/дерево_*.png

# Старые ZIP хранятся локально, новые пакеты собираются в builds/.
/Архив/Сборки_локально/
