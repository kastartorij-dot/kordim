; Нора — 3D-сцена мира Кордим (Godot 4.7)
config_version=5

[application]
config/name="Нора"
config/description="Охотничий сруб Арна, лес, ручей. Ранняя осень 1026."
run/main_scene="res://Сцены/нора.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]
Снимок="*res://Скрипты/снимок.gd"

[display]
window/size/viewport_width=1280
window/size/viewport_height=720

[rendering]
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
