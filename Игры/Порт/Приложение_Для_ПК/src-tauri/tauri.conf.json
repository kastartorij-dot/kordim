{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Порт Теней",
  "version": "0.1.1",
  "identifier": "dev.kastartorij.kordim.port-teney",
  "build": {
    "frontendDist": "https://kordim.kastartorij.workers.dev/Игра/Порт/"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Порт Теней",
        "url": "https://kordim.kastartorij.workers.dev/Игра/Порт/?desktop=1",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "devtools": false,
        "backgroundColor": "#0b0d14",
        "theme": "Dark"
      }
    ],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "RolePlayingGame",
    "shortDescription": "Текстовая ролевая игра в мире Кордима",
    "longDescription": "Настольная оболочка игры «Порт Теней». Загружает актуальную версию игры с Cloudflare при каждом запуске.",
    "homepage": "https://kordim.kastartorij.workers.dev/Игра/Порт/",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "startMenuFolder": "Кордим"
      }
    }
  }
}
