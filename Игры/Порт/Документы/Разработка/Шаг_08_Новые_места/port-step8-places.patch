@@ -4,13 +4,13 @@
 // лежит в Данные/Места/*.js, а что дом помнит между визитами — в S.мир (места, люди, темы).
 import { место } from '../Данные/места.js';
 import { НАЧАЛА } from '../Данные/герой.js';
-import { следующийОтрезок } from './время.js';
+import { следующийОтрезок, лечьСпать } from './время.js';
 import { МАКС } from './тело.js';
