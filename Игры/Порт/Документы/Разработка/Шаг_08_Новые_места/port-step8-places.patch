+// Маяк, шаг 8 (карточка 5.6 «Кто слышит»): режимы огня по ночам сезона. Таблица выписана вручную — игровое предложение
+// (draft), автор её не подтверждал. Расчётные дни (7, 14, 21, 28) — «долгая тьма»: рядом стража, судов нет.
+import { расчётныйДень } from './календарь.js';
+
+export const ДВЕ_ВСПЫШКИ = [4, 9, 12, 17, 20, 24, 27];   // ждут судно без пошлин
+export const ШТОРМ_ДЕНЬ = 16;                              // огонь гаснет, ломается заслонка
+export const ВСЕГО_ДНЕЙ = 30;
+
+export function режимНочи(день) {
+  if (день === ШТОРМ_ДЕНЬ) return 'шторм';
+  if (расчётныйДень(день)) return 'долгая тьма';
+  if (ДВЕ_ВСПЫШКИ.includes(день)) return 'две вспышки';
+  return 'ровный';
+}
+
+export const ТЕКСТ_ОГНЯ = {
+  'ровный': 'Огонь горит ровно, без перебоев. Ничего особенного: в бухту не входит и из бухты не выходит ничего, что стоило бы записать.',
