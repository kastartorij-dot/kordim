index 0000000..b6cc004
--- /dev/null
+++ b/Игры/Порт/Тесты/лекарь.mjs
@@ -0,0 +1,254 @@
+// Шаг 8, Лекарь Ворн: диагноз по состоянию героя, три вопроса, цена по виду, ложь делает лечение слабее.
+// node Порт/тест/лекарь.mjs
+import assert from 'node:assert/strict';
+import { новоеСостояние } from '../Движок/состояние.js';
+import { войти, действияСцены } from '../Движок/разговор.js';
+import { привестиОдежду } from '../Движок/одежда.js';
+import { датьТему, верностьТемы } from '../Движок/знание.js';
+import { ВОПРОСЫ } from '../Данные/лекарь.js';
+
+const кнопка = (S, текст) => действияСцены(S).find(а => а.текст === текст || а.текст.startsWith(текст));
+const нажать = (S, текст) => { const а = кнопка(S, текст); assert.ok(а, `нет кнопки «${текст}»`); assert.equal(а.можно, true, `«${текст}» недоступна: ${а.почему}`); а.выполнить(S); };
+const пойти = (S, к) => действияСцены(S).find(а => а.id === `пойти:${к}`).выполнить(S);
+const осмотреть = (S, д) => действияСцены(S).find(а => а.id === `рассмотреть:${д}`).выполнить(S);
+const м = S => S.мир.места.лекарь;
+
+function уЛекаря(день = 3, кошель = 100, S0 = null) {
+  const S = S0 ?? новоеСостояние('семья', 7);
+  S.мир.район = 'трущобы'; S.мир.день = день; S.мир.отрезок = 'день'; S.герой.кошель = кошель;
+  войти(S, 'лекарь');
+  return S;
+}
+function наКушетке(S) {
+  if (S.сцена.комната !== 'кабинет-лекаря') пойти(S, 'кабинет-лекаря');
+  нажать(S, 'Лечь на осмотр к Ворну');
+}
+// Честный ответ на текущий вопрос: вариант, верный по состоянию; у вопроса про рыбу проверить нечего — первый.
+function честно(S) {
+  const тексты = действияСцены(S).map(а => а.текст);
+  const вопрос = Object.values(ВОПРОСЫ).find(в => в.ответы.every(о => тексты.includes(о.текст)));
+  assert.ok(вопрос, 'вопрос на столе');
+  return (вопрос.ответы.find(о => верноЛи(о, S)) ?? вопрос.ответы[0]).текст;
+}
+const верноЛи = (о, S) => (о.верно ? о.верно(S) : true);
+function ложно(S) {
+  const тексты = действияСцены(S).map(а => а.текст);
+  const вопрос = Object.values(ВОПРОСЫ).find(в => в.ответы.every(о => тексты.includes(о.текст)));
+  return вопрос.ответы.find(о => о.верно && !о.верно(S))?.текст ?? null;
+}
+// Ответить на все вопросы; ложь — на первом проверяемом, если нужно.
+function ответы(S, соврать = false) {
+  let соврал = false;
+  for (let i = 0; i < 3; i++) {
+    const л = соврать && !соврал ? ложно(S) : null;
+    if (л) { соврал = true; нажать(S, л); } else нажать(S, честно(S));
+  }
+  return соврал;
+}
+const записей = S => м(S).память.знает;
+
+// ── осмотр называет факты из состояния героя; первое слово об этом — шрам запасным
+{
+  const S = уЛекаря();
+  наКушетке(S);
+  assert.equal(S.сцена.комната, 'приём');
+  assert.match(S.сцена.реплика, /мозолях от лямок/, 'у грузчика мозоли');
+  assert.match(S.сцена.реплика, /старый шрам/, 'шрам — запасной факт');
+  assert.equal(записей(S).length, 2, 'тетрадь: два факта по осмотру');
+  assert.equal(кнопка(S, 'Ответить на вопросы Ворна').подпись, 'лечение 4 гр. вместо 8');
+  assert.equal(кнопка(S, 'Заплатить полностью и промолчать').подпись, 'лечение 8 гр.');
+  assert.equal(S.сцена.ходы, 0, 'сам осмотр хода не стоит');
+}
+{
+  const S = уЛекаря();
+  S.герой.рана = 1; S.герой.боль = 1; S.герой.тело.сыт = 0;
+  наКушетке(S);
+  assert.match(S.сцена.реплика, /Рана у тебя не свежая/);
+  assert.match(S.сцена.реплика, /бережёшь одну сторону/);
+  assert.doesNotMatch(S.сцена.реплика, /давно не ел/, 'больше двух фактов Ворн не называет');
+  assert.doesNotMatch(S.сцена.реплика, /мозолях/);
+}
+{
+  const S = уЛекаря(3, 100, null);
+  S.герой.ремёсла = { грамота: { ступень: 'умеешь', зарубки: 0 } };
+  наКушетке(S);
+  assert.match(S.сцена.реплика, /мозоль от пера/);
+}
+
+// ── осмотр раз в день; на другой день тот же факт второй раз не пишется
+{
+  const S = уЛекаря();
+  наКушетке(S);
+  нажать(S, 'Заплатить полностью и промолчать');
+  нажать(S, 'Закончить приём без лечения');
+  assert.equal(S.сцена.комната, 'кабинет-лекаря');
+  assert.equal(кнопка(S, 'Лечь на осмотр к Ворну'), undefined, 'раз в день');
+}
+{
+  const S = уЛекаря(3);
+  наКушетке(S); нажать(S, 'Заплатить полностью и промолчать'); нажать(S, 'Закончить приём без лечения');
+  const был = записей(S).length;
+  const вышли = S;
+  S.сцена = null; // следующий день, новый визит
+  уЛекаря(4, 100, вышли);
+  наКушетке(S);
+  assert.equal(записей(S).length, был, 'те же факты не дублируются');
+}
+
+// ── молчать: цена полная, вопросов нет, лечение точное
+{
+  const S = уЛекаря();
+  S.герой.тело.цел = 1; S.герой.рана = 1; S.герой.боль = 1;
+  наКушетке(S);
+  нажать(S, 'Заплатить полностью и промолчать');
+  assert.equal(кнопка(S, 'Лечиться').подпись.includes('цел'), true);
+  assert.equal(кнопка(S, 'Лечиться').цена ?? 8, 8);
+  нажать(S, 'Лечиться');
+  assert.equal(S.герой.кошель, 92);
+  assert.equal(S.герой.тело.цел, 3, 'цел +2');
+  assert.equal(S.герой.рана, 0);
+  assert.equal(S.герой.боль, 0);
+  assert.match(S.сцена.реплика, /по делу/);
+  assert.equal(S.сцена.комната, 'кабинет-лекаря');
+  assert.equal(S.сцена.приём, null);
+  assert.equal(S.сцена.ходы, 1, 'лечение стоит ход');
+  assert.equal(м(S).счётчики.лечений, 1);
+  assert.equal(записей(S).length, 2, 'ответов не было — только то, что Ворн увидел');
+  assert.match(S.сцена.реплика, /про тебя теперь 2 строки/);
+}
+
+// ── ответить честно: цена вдвое меньше, ответы записаны в тетрадь
+{
+  const S = уЛекаря();
+  S.герой.тело.цел = 1;
+  наКушетке(S);
+  нажать(S, 'Ответить на вопросы Ворна');
+  assert.match(S.сцена.реплика, /Рыбу ты любишь/, 'первым идёт неважный вопрос');
+  assert.equal(кнопка(S, 'Лечиться'), undefined, 'пока идут вопросы, лечения нет');
+  const соврал = ответы(S, false);
+  assert.equal(соврал, false);
+  assert.equal(S.сцена.приём.ложь, 0);
+  assert.equal(S.сцена.приём.этап, 'исход');
+  assert.equal(S.сцена.приём.правда, 2, 'два проверяемых вопроса: оба честно');
+  assert.equal(записей(S).filter(з => з.id.startsWith('ответ:')).length, 2, 'в тетради два ответа');
+  assert.equal(кнопка(S, 'Лечиться').подпись.length > 0, true);
+  нажать(S, 'Лечиться');
+  assert.equal(S.герой.кошель, 96, 'четыре гроша вместо восьми');
+  assert.equal(S.герой.тело.цел, 3);
+  assert.equal(записей(S).length, 4);
+}
+
+// ── ложь: цена та же (Ворн не проверяет), а лечение слабее, боль остаётся, ложь в тетрадь не пишется
+{
+  const S = уЛекаря();
+  S.герой.тело.цел = 1; S.герой.рана = 2; S.герой.боль = 1;
+  наКушетке(S);
+  нажать(S, 'Ответить на вопросы Ворна');
+  const соврал = ответы(S, true);
+  assert.equal(соврал, true);
+  assert.equal(S.сцена.приём.ложь, 1);
+  assert.equal(S.сцена.приём.правда, 1);
+  assert.equal(записей(S).filter(з => з.id.startsWith('ответ:')).length, 1, 'ложный ответ не записан');
+  нажать(S, 'Лечиться');
+  assert.equal(S.герой.кошель, 96, 'Ворн ложь не проверяет: скидка осталась');
+  assert.equal(S.герой.тело.цел, 2, 'цел +1 вместо +2');
+  assert.equal(S.герой.рана, 1, 'рана ослабла, но не прошла');
+  assert.equal(S.герой.боль, 1, 'боль осталась');
+  assert.match(S.сцена.реплика, /Что-то не сходится/);
+  assert.equal(м(S).счётчики.мимо, 1);
+  assert.equal(м(S).счётчики.лжи, 1);
+}
+
+// ── настойка Ворна и отказ от лечения
+{
+  const S = уЛекаря();
+  S.герой.тело.цел = 1; S.герой.боль = 1;
+  наКушетке(S);
+  нажать(S, 'Заплатить полностью и промолчать');
+  assert.equal(кнопка(S, 'Взять настойку Ворна').подпись, '4 гр. · слабее · цел +1 · 1 ход');
+  нажать(S, 'Взять настойку Ворна');
+  assert.equal(S.герой.кошель, 96);
+  assert.equal(S.герой.тело.цел, 2);
+  assert.equal(S.герой.боль, 0);
+  assert.match(S.сцена.реплика, /Горько/);
+}
+{
+  const S = уЛекаря();
+  S.герой.тело.цел = 1;
+  наКушетке(S);
+  нажать(S, 'Заплатить полностью и промолчать');
+  нажать(S, 'Закончить приём без лечения');
+  assert.equal(S.герой.кошель, 100);
+  assert.equal(S.герой.тело.цел, 1);
+}
+
+// ── цена по виду одежды: бедному дешевле, богатому дороже
+for (const [тип, полная, скидка] of [['лохмотья', 6, 3], ['рабочая', 8, 4], ['приказчичья', 10, 5], ['купеческая', 12, 6]]) {
+  const S = уЛекаря();
+  привестиОдежду(S).база.тип = тип;
+  S.герой.одежда.база.состояние = {};
+  наКушетке(S);
+  assert.equal(кнопка(S, 'Заплатить полностью и промолчать').подпись, `лечение ${полная} гр.`, тип);
+  assert.equal(кнопка(S, 'Ответить на вопросы Ворна').подпись, `лечение ${скидка} гр. вместо ${полная}`, тип);
+}
+
+// ── нечего лечить: лечения нет, закончить можно; нет денег: лечение закрыто
+{
+  const S = уЛекаря();
+  наКушетке(S);
+  нажать(S, 'Заплатить полностью и промолчать');
+  assert.equal(кнопка(S, 'Лечиться'), undefined, 'цел 3, ран нет');
+  assert.equal(кнопка(S, 'Взять настойку Ворна'), undefined);
+  assert.ok(кнопка(S, 'Закончить приём без лечения'));
+}
+{
+  const S = уЛекаря(3, 3);
+  S.герой.тело.цел = 1;
+  наКушетке(S);
+  нажать(S, 'Заплатить полностью и промолчать');
+  assert.equal(кнопка(S, 'Лечиться').можно, false, '8 гр. нет');
+  assert.equal(кнопка(S, 'Взять настойку Ворна').можно, false, '4 гр. тоже нет');
+  assert.ok(кнопка(S, 'Закончить приём без лечения').можно);
+}
+
+// ── пока лечат, говорят: пациент с вывихом даёт тему, трясущийся — подтверждает серую радость
+{
+  const S = уЛекаря();
+  нажать(S, 'Подержать пациента с вывихом');
+  assert.ok(S.мир.темы.includes('rany_boytsov'));
+  assert.equal(кнопка(S, 'Подержать пациента с вывихом'), undefined, 'тема уже известна');
+  assert.equal(верностьТемы(S, 'seraya_radost'), null);
+  нажать(S, 'Подержать пациента, которого трясёт');
+  assert.equal(верностьТемы(S, 'seraya_radost'), 'подтверждено');
+  assert.equal(кнопка(S, 'Подержать пациента, которого трясёт'), undefined);
+}
+{
+  const S = уЛекаря();
+  датьТему(S, 'seraya_radost', 'слышал');
+  нажать(S, 'Подержать пациента, которого трясёт');
+  assert.equal(верностьТемы(S, 'seraya_radost'), 'подтверждено', 'слух стал проверенным');
+}
+
+// ── осмотр комнат: счёт Милы, календарь, банка осколков, тетрадь
+{
+  const S = уЛекаря(3);
+  осмотреть(S, 'счёт');
+  assert.match(S.сцена.реплика, /сегодня уже 5-й раз/);
+  осмотреть(S, 'календарь');
+  assert.match(S.сцена.реплика, /Числа на нём нет/);
+  пойти(S, 'кабинет-лекаря');
+  осмотреть(S, 'зуб');
+  assert.ok(S.мир.темы.includes('rany_boytsov'));
+  осмотреть(S, 'тетрадь');
+  assert.ok(S.мир.темы.includes('lekar_zapisi'));
+  assert.match(S.сцена.реплика, /Про тебя в ней сейчас 0 строк/);
+  осмотреть(S, 'карточка');
+  assert.ok(S.мир.свидетельства.includes('brenn_healer_card'));
+  нажать(S, 'Лечь на осмотр к Ворну');
+  нажать(S, 'Заплатить полностью и промолчать');
+  нажать(S, 'Закончить приём без лечения');
+  осмотреть(S, 'тетрадь');
+  assert.match(S.сцена.реплика, /Про тебя в ней сейчас 2 строки/);
+}
+
+console.log('Лекарь Ворн: диагноз, три вопроса, цена по виду, ложь, настойка, помощь пациентам — OK');
