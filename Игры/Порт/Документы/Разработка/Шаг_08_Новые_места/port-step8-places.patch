+++ b/Игры/Порт/Тесты/лачуга.mjs
@@ -0,0 +1,403 @@
+// Шаг 8, Лачуга Локи: мостки (доски, груз, Кук, вода), голос называет вещи, торг «не золотом», пять услуг,
+// труд телом, правда чужая и своя, большая вода, улов дня, сохранение. node Игры/Порт/Тесты/лачуга.mjs
+import assert from 'node:assert/strict';
+import { новоеСостояние } from '../Движок/состояние.js';
+import { войти, можноВойти, действияСцены } from '../Движок/разговор.js';
+import { датьТему, верностьТемы } from '../Движок/знание.js';
+import { положить, естьВещь } from '../Движок/вещи.js';
+import { датьРемесло } from '../Движок/ремёсла.js';
+import { тихаяДоска, названиеВещей } from '../Движок/лачуга.js';
+import { МЕСТА } from '../Данные/места.js';
+import { ДОСКИ, ДОСКИ_ИМ, БОЛЬШАЯ_ВОДА, УСЛУГИ } from '../Данные/лачуга.js';
+
+const кнопка = (S, текст) => действияСцены(S).find(а => а.текст === текст || а.текст.startsWith(текст));
+const нажать = (S, текст) => { const а = кнопка(S, текст); assert.ok(а, `нет кнопки «${текст}»`); assert.equal(а.можно, true, `«${текст}» недоступна: ${а.почему}`); а.выполнить(S); };
+const нет = (S, текст) => assert.equal(кнопка(S, текст), undefined, `кнопка «${текст}» не должна быть`);
+const пойти = (S, к) => { const а = действияСцены(S).find(а => а.id === `пойти:${к}`); assert.ok(а, `нет перехода в ${к}`); а.выполнить(S); };
+const осмотреть = (S, д) => действияСцены(S).find(а => а.id === `рассмотреть:${д}`).выполнить(S);
+const тень = S => S.мир.тень ?? 0;
+const журнал = (S, часть) => S.мир.журналДня.some(с => с.includes(часть));
+
+function вЛачуге(день = 5, отрезок = 'день', кошель = 30, S0 = null) {
+  const S = S0 ?? новоеСостояние('семья', 11);
+  S.мир.район = 'локи'; S.мир.день = день; S.мир.отрезок = отрезок; S.герой.кошель = кошель; S.мир.конецДня = null;
+  S.герой.при_себе = [];
+  войти(S, 'лачуга-локи');
+  return S;
+}
+const тихо = S => S.сцена.лачуга?.тихо;
+// Тихая доска: левая, средняя, правая по кругу от дня. Берём ту, что молчит.
+const тихаяКнопка = S => `Ступить на ${ДОСКИ[тихаяДоска(S)]} доску`;
+function внутрь(день = 5, отрезок = 'день', кошель = 30, S0 = null) {
+  const S = вЛачуге(день, отрезок, кошель, S0);
+  нажать(S, тихаяКнопка(S));
+  пойти(S, 'внутри-локи');
+  return S;
+}
+const торговаться = S => нажать(S, 'Сказать, что пришёл торговаться');
+const этап = S => S.сцена.лачуга?.этап;
+const взнос = S => S.мир.места['лачуга-локи'].память?.взнос ?? 0;
+
+// ── расписание и вход
+{
+  const S = новоеСостояние('семья', 1);
+  S.мир.район = 'локи'; S.мир.день = 3;
+  for (const о of ['утро', 'день', 'вечер', 'ночь']) { S.мир.отрезок = о; assert.equal(можноВойти(S, 'лачуга-локи').можно, true, о); }
+  assert.ok(МЕСТА.find(м => м.id === 'лачуга-локи'));
+}
+
+// ── мостки: тихая доска по дню, любая другая выдаёт, груз скрипит и на тихой
+for (const день of [5, 6, 7, 8]) {
+  const S = вЛачуге(день);
+  assert.equal(тихаяДоска(S), (день + 1) % 3);
+  for (const [i, д] of ДОСКИ.entries()) {
+    const T = вЛачуге(день);
