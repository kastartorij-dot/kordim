index 0000000..fc8477d
--- /dev/null
+++ b/Игры/Порт/Тесты/ночлежка.mjs
@@ -0,0 +1,379 @@
+// Шаг 8, Ночлежка: куда лёг кошелёк, воск, одеяло, колода ночи, книга кроватей.
+// node Порт/тест/ночлежка.mjs
+import assert from 'node:assert/strict';
+import { новоеСостояние } from '../Движок/состояние.js';
+import { войти, действияСцены } from '../Движок/разговор.js';
+import { доступныеДействия } from '../Движок/действия.js';
+import { верностьТемы } from '../Движок/знание.js';
+import { положить } from '../Движок/вещи.js';
+import { КОЛОДА, ПОСТОЯЛЬЦЫ } from '../Данные/ночлежка.js';
+
+const кнопка = (S, текст) => действияСцены(S).find(а => а.текст === текст || а.текст.startsWith(текст));
+const нажать = (S, текст) => { const а = кнопка(S, текст); assert.ok(а, `нет кнопки «${текст}»`); assert.equal(а.можно, true, `«${текст}» недоступна: ${а.почему}`); а.выполнить(S); };
+const пойти = (S, к) => действияСцены(S).find(а => а.id === `пойти:${к}`).выполнить(S);
+const распол = (S, кто) => S.мир.люди[кто]?.распол ?? 0;
+const м = S => S.мир.места.ночлежка;
+const н = S => S.сцена.ночь;
+
+function вНочлежке(день = 3, кошель = 100, отрезок = 'вечер', S0 = null) {
+  const S = S0 ?? новоеСостояние('семья', 7);
+  S.мир.район = 'трущобы'; S.мир.день = день; S.мир.отрезок = отрезок; S.герой.кошель = кошель;
+  S.мир.погода = 'ясно';
+  войти(S, 'ночлежка');
+  return S;
+}
+const клон = S => JSON.parse(JSON.stringify(S));
+// Подбираем зерно монеты, при котором кнопка даёт нужный исход, и ставим его в настоящее состояние.
+function сидГде(S, лечь, условие) {
+  for (let с = 1; с < 3000; с++) {
+    const S2 = клон(S);
+    S2.мир.сид = с;
+    нажатьТихо(S2, лечь);
+    if (условие(S2)) { S.мир.сид = с; return с; }
+  }
+  assert.fail(`не нашлось зерна для «${лечь}»`);
+}
+const нажатьТихо = (S, текст) => кнопка(S, текст).выполнить(S);
+const колодаСейчас = S => действияСцены(S).filter(а => а.текст !== 'Дождаться утра');
+// Пройти ночь до конца, каждый раз выбирая вариант с номером «какой» (0 — первый). Возвращает тексты выбора.
+function доутра(S, какой = 0) {
+  const выборы = [];
+  for (let i = 0; i < 12; i++) {
+    const ут = кнопка(S, 'Дождаться утра');
+    if (ут) { ут.выполнить(S); return выборы; }
+    const все = колодаСейчас(S);
+    const а = все[Math.min(какой, все.length - 1)];
+    выборы.push(а.текст);
+    а.выполнить(S);
+  }
+  assert.fail('ночь не кончилась');
+}
+const строкиУтра = S => S.мир.конецДня.журнал;
+
+// ── вечером можно лечь тремя способами, утром и ночью — нет
+{
+  const S = вНочлежке(3, 100, 'вечер');
+  assert.equal(кнопка(S, 'Отдать кошелёк Тону и лечь').можно, true);
+  assert.match(кнопка(S, 'Отдать кошелёк Тону и лечь').подпись, /3 гр\./);
+  assert.match(кнопка(S, 'Отдать кошелёк Тону и лечь').подпись, /риска нет/);
+  пойти(S, 'общая-комната');
+  assert.match(кнопка(S, 'Лечь, кошелёк в сапог').подпись, /риск 1\/10/);
+  assert.match(кнопка(S, 'Лечь, кошелёк под голову').подпись, /риск 1\/6/);
+  assert.match(кнопка(S, 'Лечь, кошелёк под голову').подпись, /услышишь ночь/);
+  assert.match(кнопка(S, 'Лечь, кошелёк в сапог').подпись, /2 гр\./);
+
+  const утро = вНочлежке(3, 100, 'утро');
+  assert.equal(кнопка(утро, 'Отдать кошелёк Тону и лечь'), undefined, 'утром спать нельзя');
+  пойти(утро, 'общая-комната');
+  assert.equal(кнопка(утро, 'Лечь, кошелёк в сапог'), undefined);
+}
+{
+  const S = вНочлежке(3, 1, 'вечер');
+  assert.equal(кнопка(S, 'Отдать кошелёк Тону и лечь').можно, false, '3 гр. нет');
+  пойти(S, 'общая-комната');
+  assert.equal(кнопка(S, 'Лечь, кошелёк в сапог').можно, false, 'койка стоит 2 гр.');
+}
+
+// ── кошелёк у Тона: воровать нечего, Тон знает сумму; ночь кончается сном и экраном конца дня
+for (let с = 1; с <= 60; с++) {
+  const S = вНочлежке(3, 100);
+  S.мир.сид = с;
+  S.герой.тело.отдых = 0;
+  нажать(S, 'Отдать кошелёк Тону и лечь');
+  assert.equal(S.сцена.комната, 'койка');
+  assert.equal(н(S).вор, false, 'у Тона не крадут');
+  assert.equal(м(S).память.знаетСумму, 97, 'Тон запомнил сумму после платы');
+  assert.ok(S.мир.журналДня.some(с => с.includes('Тон Брикс знает')));
+  assert.equal(н(S).карты.includes('шаги'), false);
+  const день = S.мир.день;
+  доутра(S);
+  assert.equal(S.сцена, null, 'сцена закрыта: утро');
+  assert.ok(S.мир.конецДня, 'экран конца дня');
+  assert.equal(S.мир.день, день + 1);
+  assert.equal(S.мир.конецДня.сон, 'Ночлежка');
+  assert.ok(S.герой.тело.отдых >= 1, 'отдых +1');
+  assert.equal(strokaNet(строкиУтра(S), 'украли'), true, 'ничего не украли');
+  assert.equal(м(S).счётчики.хранений, 1);
+  assert.equal(м(S).счётчики.ночей, 1);
+}
+function strokaNet(строки, слово) { return !строки.some(с => с.includes(слово)); }
+
+// ── кража: «шаги у кошелька» приходят первой картой; притвориться спящим — кража состоялась
+{
+  const S = вНочлежке(3, 100);
+  S.герой.при_себе = [];
+  пойти(S, 'общая-комната');
+  сидГде(S, 'Лечь, кошелёк в сапог', T => н(T).вор);
+  нажать(S, 'Лечь, кошелёк в сапог');
+  assert.equal(S.герой.кошель, 98);
+  assert.equal(н(S).карты[0], 'шаги');
+  assert.match(S.сцена.реплика, /Шаги у твоей койки/);
+  assert.match(S.сцена.реплика, /у сапога/);
+  assert.ok(кнопка(S, 'Схватить вора за руку'));
+  нажать(S, 'Притвориться спящим');
+  assert.match(S.сцена.реплика, /Рука работает быстро/);
+  доутра(S);
+  assert.ok(S.мир.конецДня.журнал.some(с => с.includes('украли 49 гр.')), 'украли половину кошеля: ' + S.мир.конецДня.журнал.join('|'));
+  assert.equal(S.герой.кошель, 49);
+  assert.equal(м(S).счётчики.украдено, 1);
+}
+{
+  // под подушкой у тебя в сумке есть вещь — берут её, а не деньги
+  const S = вНочлежке(3, 100);
+  положить(S, 'пирог', 1, {});
+  пойти(S, 'общая-комната');
+  сидГде(S, 'Лечь, кошелёк в сапог', T => н(T).вор);
+  нажать(S, 'Лечь, кошелёк в сапог');
+  const вещей = S.герой.при_себе.length;
+  assert.equal(вещей, 1);
+  нажать(S, 'Притвориться спящим');
+  доутра(S);
+  assert.equal(S.герой.кошель, 98, 'деньги целы, если нашлось что взять из сумки');
+  assert.equal(S.герой.при_себе.length, вещей - 1);
+}
+
+// ── перехват: под головой хватаешь вора наверняка; в сапоге — с шансом в половину
+{
+  const S = вНочлежке(3, 100);
+  пойти(S, 'общая-комната');
+  сидГде(S, 'Лечь, кошелёк под голову', T => н(T).вор);
+  нажать(S, 'Лечь, кошелёк под голову');
+  assert.match(S.сцена.реплика, /у подушки/);
+  assert.equal(н(S).чуткий, true);
+  нажать(S, 'Схватить вора за руку');
+  assert.match(S.сцена.реплика, /ловишь запястье/);
+  assert.equal(н(S).вор, false);
+  доутра(S);
+  assert.equal(S.герой.кошель, 98, 'под головой вора поймал, всё цело');
+  assert.ok(S.мир.конецДня.журнал.some(с => с.includes('Поймал вора')));
+}
+{
+  const S = вНочлежке(3, 100);
+  пойти(S, 'общая-комната');
+  сидГде(S, 'Лечь, кошелёк в сапог', T => { if (!н(T).вор) return false; нажатьТихо(T, 'Схватить вора за руку'); return н(T).вор === false; });
+  нажать(S, 'Лечь, кошелёк в сапог');
+  нажать(S, 'Схватить вора за руку');
+  assert.equal(н(S).вор, false, 'удачный бросок: вора поймал');
+  assert.match(S.сцена.реплика, /ловишь запястье/);
+}
+{
+  const S = вНочлежке(3, 100);
+  S.герой.при_себе = [];
+  пойти(S, 'общая-комната');
+  сидГде(S, 'Лечь, кошелёк в сапог', T => { if (!н(T).вор) return false; нажатьТихо(T, 'Схватить вора за руку'); return н(T).вор === true; });
+  нажать(S, 'Лечь, кошелёк в сапог');
+  нажать(S, 'Схватить вора за руку');
+  assert.equal(н(S).вор, true, 'неудачный бросок: проснулся поздно');
+  assert.match(S.сцена.реплика, /на удар сердца позже/);
+  доутра(S);
+  assert.equal(S.герой.кошель, 49);
+}
+
+// ── воск: отдых +1, ночь не слышишь, кража вдвое вероятнее
+{
+  const S = вНочлежке(3, 100);
+  нажать(S, 'Купить у Тона воск для ушей');
+  assert.equal(S.герой.кошель, 99);
+  assert.equal(кнопка(S, 'Купить у Тона воск для ушей'), undefined, 'один воск на ночь');
+  пойти(S, 'общая-комната');
+  assert.match(кнопка(S, 'Лечь, кошелёк в сапог').подпись, /риск 2\/10/);
+  S.герой.тело.отдых = 0;
+  нажать(S, 'Лечь, кошелёк в сапог');
+  assert.deepEqual(н(S).карты, [], 'воск: случаев не слышно');
+  assert.equal(н(S).воск, true);
+  assert.match(S.сцена.реплика, /Воск в ушах/);
+  assert.ok(кнопка(S, 'Дождаться утра'), 'сразу до утра');
+  нажать(S, 'Дождаться утра');
+  assert.equal(S.герой.тело.отдых, 2, 'отдых +2 вместо +1');
+  assert.equal(S.мир.конецДня.сон, 'Ночлежка, воск в ушах');
+}
+{
+  // без воска те же условия дают только +1
+  const S = вНочлежке(3, 100);
+  S.герой.тело.отдых = 0;
+  сидГде(S, 'Отдать кошелёк Тону и лечь', T => true);
+  нажать(S, 'Отдать кошелёк Тону и лечь');
+  доутра(S);
+  assert.equal(S.герой.тело.отдых, 1);
+}
+
+// ── одеяло: с дня 21 без него осенние холода отнимают тепло
+for (const [день, берём] of [[20, false], [21, false], [21, true]]) {
