+// Люди в комнате (проба 13.11, доска Р24): вырезанный портрет стоит в своей точке фона комнаты,
+// в масштабе комнаты и под её свет; нажал — заговорить. В разговоре — прежний крупный план (#portrait).
+// Точки — Данные/фоны-комнат.js, ЛЮДИ_В_КОМНАТЕ. На узком экране слой скрыт (интерфейс.css): сцена — полоса.
+const размеры = new Map();
+function размер(url) {
+  if (!размеры.has(url)) размеры.set(url, new Promise(ок => {
+    const i = new Image(); i.onload = () => ок([i.naturalWidth, i.naturalHeight]); i.onerror = () => ок(null); i.src = url;
+  }));
+  return размеры.get(url);
+}
+
+// Свет комнаты на вырезке: задник сверху тонируется по часу (.з-время), вырезка над ним — тонируем фильтром.
+const СВЕТ = { утро: 'brightness(.96)', день: 'brightness(.96)', вечер: 'brightness(.84) saturate(.92)', ночь: 'brightness(.72) saturate(.85)' };
+
+// сцена — #scene; фон — url задника; позиция — как у задника ('center 40%' → [.5, .4]);
+// люди — [{ точка: { x, низ, рост }, файл, подпись, заговорить }], точка — доли ширины и высоты картинки фона.
+export async function поставитьЛюдей(сцена, фон, люди, { позиция = [.5, .4], час = '' } = {}) {
+  сцена.querySelector('.люди-комнаты')?.remove();
+  if (!люди.length) return;
+  const р = await размер(фон);
+  if (!р || !сцена.isConnected) return;
+  сцена.querySelector('.люди-комнаты')?.remove();
+  const слой = document.createElement('div');
+  слой.className = 'люди-комнаты';
+  for (const ч of люди) {
+    const b = document.createElement('button');
+    b.className = 'в-комнате';
+    b.dataset.точка = JSON.stringify(ч.точка);
+    b.title = ч.подпись; b.setAttribute('aria-label', ч.подпись);
+    b.innerHTML = '<img alt="" src="' + ч.файл + '">';
+    b.querySelector('img').style.filter = (СВЕТ[час] ?? '') + ' drop-shadow(0 6px 14px rgba(0,0,0,.55))';
+    b.onclick = ч.заговорить;
+    слой.appendChild(b);
+  }
+  сцена.appendChild(слой);
+  // Задник: position fixed, кадр на 3% шире экрана с каждой стороны, cover, без дрейфа (класс «тихо»).
+  const разложить = () => {
+    if (!слой.isConnected) { removeEventListener('resize', разложить); return; }
+    const W = innerWidth, H = innerHeight, кw = W * 1.06, кh = H * 1.06, [iw, ih] = р, s = Math.max(кw / iw, кh / ih);
+    const L = -.03 * W + (кw - iw * s) * позиция[0], T = -.03 * H + (кh - ih * s) * позиция[1];
+    const с = сцена.getBoundingClientRect();
+    for (const b of слой.children) {
+      const т = JSON.parse(b.dataset.точка), h = т.рост * ih * s;
+      b.style.height = h + 'px';
+      b.style.left = (L + т.x * iw * s - с.left) + 'px';
+      b.style.top = (T + т.низ * ih * s - h - с.top) + 'px';
+    }
+  };
+  addEventListener('resize', разложить);
+  разложить();
+}
