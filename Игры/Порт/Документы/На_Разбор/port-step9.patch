+// «Свой угол» (шаг 9 плана): договор на комнату над меняльной, взносы, просрочка, расторжение, возврат вещей.
+// Чистая логика без DOM. Состояние живёт в S.мир.угол и создаётся лениво (миграция версии не нужна).
+// Правила: документы/задания-другим-ИИ/шаг-1/Четыре_цели_первого_сезона.md, карточка «Свой угол».
+import { ДОГОВОР, ДЕНЬ_ФИНАЛА, ВЕСЬ_ДОГОВОР, платёжПриПодписи, числа } from '../данные/цели.js';
