@@ -0,0 +1,94 @@
+// Шаг 9 плана: четыре главные цели первого сезона. Здесь только данные и чистые расчёты цен —
+// без состояния и без DOM. Источник правил: документы/задания-другим-ИИ/шаг-1/Четыре_цели_первого_сезона.md.
+// Числа договора — игровые параметры для проверки балансом, не факты канона.
+
+export const ДЕНЬ_ВЫБОРА = 3; // с этого дня журнал предлагает направление
+export const ДЕНЬ_ФИНАЛА = 30;
+
+// «готова» — цель можно выбрать в журнале. Цели без полного содержания не предлагаются:
+// неполные цели промежуточной сборки не объявляются готовыми (ПЛАН П09.4).
+export const ЦЕЛИ = {
+  угол: {
+    id: 'угол', имя: 'Свой угол', готова: true,
+    кратко: 'Комната, договор и право на неё к тридцатому дню.',
+  },
+  имя: { id: 'имя', имя: 'Имя', готова: false, кратко: 'Стать независимым посредником или человеком одной стороны.' },
+  вытащить: { id: 'вытащить', имя: 'Вытащить', готова: false, кратко: 'Помочь человеку из «Синего часа» сделать собственный выбор.' },
+  уехать: { id: 'уехать', имя: 'Уехать', готова: false, кратко: 'Выбрать путь из города и добраться до отплытия.' },
+};
+
+// «Свой угол»: 60 + 4 × 30 = 180 грошей. Ночлег и сундук после подписи входят в цену.
+export const ДОГОВОР = {
+  задаток: 60,
+  взнос: 30,
+  сбор: 10,            // один раз за первый пропуск действующего договора
+  сроки: [7, 14, 21, 28],
+  первыйДень: 3,       // договор предлагается с 3-го дня
+  последняяПодпись: 14,
+  заранеЗа: 3,         // взнос можно внести не раньше чем за три дня до срока (решение реализации)
+};
+
+// Что платится при подписи в данный день.
+//  3–6:  60;  7: 60 при подписи + 30 до конца дня;  8–13: 90;  14: 120 (оба наступивших взноса сразу).
+// Даты до подписи не считаются пропусками и не получают сбор.
+export function платёжПриПодписи(день) {
+  if (!Number.isInteger(день) || день < ДОГОВОР.первыйДень || день > ДОГОВОР.последняяПодпись) return null;
+  const включено = ДОГОВОР.сроки.filter(d => d < день || (d === день && день === ДОГОВОР.последняяПодпись));
+  const сейчас = ДОГОВОР.задаток + ДОГОВОР.взнос * включено.length;
+  const доКонцаДня = ДОГОВОР.сроки.includes(день) && !включено.includes(день) ? ДОГОВОР.взнос : 0;
+  return { сейчас, доКонцаДня, всего: сейчас + доКонцаДня, включено };
+}
+
+export const ВЕСЬ_ДОГОВОР = ДОГОВОР.задаток + ДОГОВОР.взнос * ДОГОВОР.сроки.length; // 180
+
+// Заём у Орша: один открытый заём, возврат с комиссией.
+export const ЗАЁМ = { сумма: 30, вернуть: 36 };
+
+// Склонение: числа(3, ['смена','смены','смен']) → «3 смены».
+export function числа(n, формы) {
+  const a = Math.abs(n) % 100, b = a % 10;
+  const f = a > 10 && a < 20 ? формы[2] : b === 1 ? формы[0] : b >= 2 && b <= 4 ? формы[1] : формы[2];
+  return `${n} ${f}`;
+}
