+// Шаг 9: общая система целей и полный «Свой угол». Запуск: node Порт/тест/шаг9.mjs
+import assert from 'node:assert/strict';
+import { новоеСостояние, мигрировать } from '../движок/состояние.js';
+import { войти, действияСцены, вернутьсяВГород, видСцены } from '../движок/разговор.js';
+import { лечьСпать, потратитьОтрезок } from '../движок/время.js';
+import { ЖИЛЬЁ } from '../данные/жильё.js';
+import { ДОГОВОР, ВЕСЬ_ДОГОВОР, платёжПриПодписи, ДЕНЬ_ФИНАЛА } from '../данные/цели.js';
+import { угол, платёж, стоимостьУгла, договорДействует, исходУгла } from '../движок/угол.js';
+import { цели, выбратьЦель, снятьЦель, действияЦелей, сводкаЦели, итогСезона, выполнитьУгол } from '../движок/цели.js';
+import { сводкаЖурнала } from '../движок/сводка.js';
+import { доступныеДействия } from '../движок/действия.js';
+import { положить, привестиВещи } from '../движок/вещи.js';
+import { доступенСундук, убратьВСундук } from '../движок/хозяйство.js';
+
+const новая = (день = 3, кошель = 400) => {
+  const S = новоеСостояние('бумаги', 7);
+  S.мир.день = день; S.мир.отрезок = 'утро'; S.мир.район = 'торговый'; S.герой.кошель = кошель;
+  return S;
+};
+
+// Закрыть сутки как игровой день: ночь без сна проходит через ту же функцию, что и сон.
+function конецДня(S, жильё = null) {
+  S.мир.отрезок = 'ночь';
+  лечьСпать(S, жильё);
+  const итог = S.мир.конецДня;
+  S.мир.конецДня = null;
+  S.мир.отрезок = 'утро';
+  return итог;
+}
+const доДня = (S, день) => { while (S.мир.день < день) конецДня(S); };
+
+// ── 1. Цены подписи по дням — ровно по таблице шага 1 ────────────────────────
+{
+  assert.equal(платёжПриПодписи(2), null);
+  for (const d of [3, 4, 5, 6]) assert.equal(платёжПриПодписи(d).сейчас, 60);
+  assert.deepEqual([платёжПриПодписи(7).сейчас, платёжПриПодписи(7).доКонцаДня, платёжПриПодписи(7).всего], [60, 30, 90]);
+  for (const d of [8, 9, 10, 11, 12, 13]) assert.equal(платёжПриПодписи(d).сейчас, 90, `день ${d}`);
+  assert.equal(платёжПриПодписи(14).сейчас, 120);
+  assert.equal(платёжПриПодписи(14).доКонцаДня, 0);
+  assert.equal(платёжПриПодписи(15), null);
+  assert.equal(ВЕСЬ_ДОГОВОР, 180);
+  // Вся цена сходится: подпись + оставшиеся взносы = 180 в любой день подписи.
+  for (let d = 3; d <= 14; d++) {
+    const ц = платёжПриПодписи(d), остаток = ДОГОВОР.сроки.filter(x => !ц.включено.includes(x)).length * ДОГОВОР.взнос;
+    assert.equal(ц.сейчас + остаток, 180, `день ${d}: сумма договора`);
+  }
+}
+
+// ── 2. Сцена меняльной: услышать → осмотреть → подписать, деньги списываются ровно один раз ──
+const ищи = (S, шаблон) => действияСцены(S).find(а => шаблон.test(а.текст));
+{
+  const S = новая(5);
+  войти(S, 'меняльная');
+  assert.equal(ищи(S, /Подписать договор/), undefined, 'без разговора о комнате подписи нет');
+  assert.equal(действияСцены(S).some(а => а.id === 'пойти:комната-над-меняльной'), false);
+  действияСцены(S).find(а => а.id === 'пойти:коридор-меняльной').выполнить(S);
+  assert.equal(действияСцены(S).some(а => а.id === 'пойти:комната-над-меняльной'), false, 'комната скрыта до слуха');
+  действияСцены(S).find(а => а.id === 'пойти:окно-меняльной').выполнить(S);
+  const до = S.герой.кошель, ходыДо = S.сцена.ходы;
+  ищи(S, /Спросить Орша о свободной комнате/).выполнить(S);
+  assert.equal(S.герой.кошель, до, 'вопрос бесплатен');
+  assert.equal(S.сцена.ходы, ходыДо, 'вопрос не тратит ход');
+  assert.equal(угол(S).услышал, true);
+  assert.equal(ищи(S, /Спросить Орша о свободной комнате/), undefined, 'повторно не спросить');
+  // осмотр комнаты бесплатный
+  действияСцены(S).find(а => а.id === 'пойти:коридор-меняльной').выполнить(S);
+  действияСцены(S).find(а => а.id === 'пойти:комната-над-меняльной').выполнить(S);
+  действияСцены(S).find(а => а.id === 'рассмотреть:осмотр-комнаты').выполнить(S);
+  assert.equal(угол(S).осмотрена, true);
+  assert.equal(S.герой.кошель, до);
+  действияСцены(S).find(а => а.id === 'пойти:коридор-меняльной').выполнить(S);
+  действияСцены(S).find(а => а.id === 'пойти:окно-меняльной').выполнить(S);
+  // подпись: цена из данных = цена движка (чтобы данные сцены и правила не разошлись)
+  const подп = ищи(S, /Подписать договор/);
+  assert.ok(подп && подп.можно, 'подпись доступна');
+  assert.match(подп.подпись, /60 гр\./);
+  assert.match(подп.подпись, /далее по 30: дни 7, 14, 21, 28/);
+  подп.выполнить(S);
+  assert.equal(S.герой.кошель, до - 60, 'ровно один раз списано');
+  assert.equal(договорДействует(S), true);
+  assert.equal(угол(S).подписан, 5);
+  assert.equal(цели(S).выбрана, 'угол');
+  assert.equal(цели(S).зафиксирована, true);
+  assert.equal(ищи(S, /Подписать договор/), undefined, 'повторно не подписать');
+  assert.equal(S.герой.жильё.id, 'угол');
+  assert.ok(Object.values(S.мир.обязательства).some(о => о.id === 'угол_взнос_7' && о.статус === 'активно'));
+}
+
+// ── 3. Подпись с нехваткой денег: кнопка недоступна, ничего не списывается ──────
+{
+  const S = новая(8, 80);
+  угол(S).услышал = true;
+  войти(S, 'меняльная');
+  const подп = ищи(S, /Подписать договор/);
+  assert.equal(подп.можно, false);
+  assert.equal(подп.выполнить(S), null);
+  assert.equal(S.герой.кошель, 80);
+  assert.equal(договорДействует(S), false);
+}
+
+// ── 4. Подпись на 7-м, 8-м и 14-м днях: сумма и отсутствие штрафов за прошлое ──
+for (const [день, ждём, остатокДолга] of [[7, 60, 30], [8, 90, 0], [14, 120, 0]]) {
+  const S = новая(день, 500);
+  угол(S).услышал = true;
+  assert.equal(выполнитьУгол(S, 'подписать'), true);
+  assert.equal(500 - S.герой.кошель, ждём, `день ${день}: платёж при подписи`);
+  assert.equal(угол(S).долг, 0, 'прошлые даты не штрафуются');
+  assert.equal(угол(S).сборов, 0);
+  const п = платёж(S);
+  if (день === 7) assert.equal(п.взнос.сумма, остатокДолга, 'на 7-м ещё 30 до конца дня');
+}
+{
+  const S = новая(15, 500);
+  угол(S).услышал = true;
+  assert.equal(выполнитьУгол(S, 'подписать'), false, 'после 14-го договор не заключается');
+  assert.equal(S.герой.кошель, 500);
+}
+
+// ── 5. Честный путь: платить в срок, договор выплачен, итог «без долга» ────────
+{
+  const S = новая(3, 400);
+  угол(S).услышал = true;
+  выполнитьУгол(S, 'подписать');
+  let кошель = S.герой.кошель;
+  for (const d of ДОГОВОР.сроки) {
+    доДня(S, d);
+    assert.equal(S.мир.день, d);
+    assert.equal(платёж(S).взнос.день, d, `взнос ${d} доступен в свой день`);
+    assert.equal(выполнитьУгол(S, 'платёж-взнос'), true);
+    кошель -= 30;
+    assert.equal(S.герой.кошель, кошель);
+  }
+  assert.equal(угол(S).выплачен, true);
+  assert.equal(S.герой.кошель, 400 - 180, 'весь договор — 180 гр.');
+  доДня(S, ДЕНЬ_ФИНАЛА);
+  const итог = (S.мир.отрезок = 'ночь', лечьСпать(S, null), S.мир.конецДня);
+  assert.ok(итог.финал, 'на дне 30 есть итог сезона');
+  assert.equal(итог.финал.исход, 'без-долга');
+  assert.equal(S.мир.день, ДЕНЬ_ФИНАЛА + 1, 'после итога игра продолжается');
+  assert.equal(S.мир.итогСезона.исход, 'без-долга');
+  assert.equal(договорДействует(S), true, 'комната остаётся за героем');
+}
+
+// ── 6. Один пропуск: долг 30 + сбор 10, один раз; закрыл — счётчик подряд сброшен ──
+{
+  const S = новая(3, 500);
+  угол(S).услышал = true;
+  выполнитьУгол(S, 'подписать');
+  доДня(S, 7);
+  const итог = конецДня(S); // день 7 закрыт без взноса
+  assert.equal(угол(S).долг, 40);
+  assert.equal(угол(S).сборов, 1);
+  assert.equal(договорДействует(S), true);
+  assert.ok(итог.причины.some(с => с.includes('Долг 40 гр.')));
+  assert.equal(S.мир.день, 8);
+  // повторные сутки без платежа не добавляют второй сбор
+  конецДня(S);
+  assert.equal(угол(S).долг, 40);
