+import { ЦЕЛИ, ДЕНЬ_ВЫБОРА, ДЕНЬ_ФИНАЛА, ИТОГИ_УГЛА, ИТОГ_БЕЗ_ЦЕЛИ, НОЧЛЕГИ_СЛОВАМИ, числа } from '../данные/цели.js';
