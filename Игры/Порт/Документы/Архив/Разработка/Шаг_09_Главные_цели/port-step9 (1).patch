+  const итог = S.мир.конецДня; S.мир.конецДня = null; S.мир.отрезок = 'утро'; return итог;
+}
+const доДня = (S, день) => { while (S.мир.день < день) конецДня(S); };
+const ступень = (S, к) => S.мир.фракции[к];
+
+// Шаг по сценам: войти → перейти в комнату → нажать действие по тексту → выйти.
+function вСцене(S, место, комната, шаблон) {
+  вернутьсяВГород(S);
+  S.мир.район = { меняльная: 'торговый', 'контора-дорров': 'доки', 'двор-горма': 'трущобы', часовня: 'маяк' }[место];
+  S.мир.отрезок = 'утро';
+  войти(S, место);
+  let к = 0;
+  while (S.сцена.комната !== комната && к++ < 5) {
+    const шаг = действияСцены(S).find(а => а.id.startsWith('пойти:') && а.id !== `пойти:${S.сцена.комната}`);
+    // ближайший путь: прямой сосед или через общую комнату
+    const прямой = действияСцены(S).find(а => а.id === `пойти:${комната}`);
+    (прямой ?? шаг).выполнить(S);
+  }
+  assert.equal(S.сцена.комната, комната, `не дошли до комнаты ${комната}`);
+  const а = действияСцены(S).find(х => шаблон.test(х.текст));
+  return а ?? null;
+}
+const жми = (S, место, комната, шаблон) => {
+  const а = вСцене(S, место, комната, шаблон);
+  assert.ok(а, `нет действия ${шаблон} в ${комната}`);
+  assert.equal(а.можно !== false, true, `действие недоступно: ${шаблон}`);
+  а.выполнить(S);
+  вернутьсяВГород(S);
+};
+const нет = (S, место, комната, шаблон) => assert.equal(вСцене(S, место, комната, шаблон), null, `не должно быть: ${шаблон}`);
+const ОКНО = ['меняльная', 'окно-меняльной'], КОРИДОР = ['меняльная', 'коридор-меняльной'];
+const ПРИЁМНАЯ = ['контора-дорров', 'приёмная-дорров'], КАБИНЕТ = ['контора-дорров', 'кабинет-дорров'];
+const СТОЛ = ['двор-горма', 'стол-горма'], ВОРОТА = ['двор-горма', 'ворота-горма'], НЕФ = ['часовня', 'неф-часовни'];
+
+// Быстрый путь к состоянию: взять письмо и пройти его честно, получить обязательство перед картелем и ножами.
+const письмоЧестно = S => {
+  const сегодня = S.мир.день;
+  if (сегодня > 8) S.мир.день = 4; // письмо берут в дни 3–8: берём «тогда», дальше тест живёт в нужном дне
+  жми(S, ...ОКНО, /Взять запечатанное письмо/);
+  жми(S, ...КАБИНЕТ, /попросить вскрыть при тебе/);
+  S.мир.день = сегодня;
+};
+
+// ── 1. Окно предложения письма: дни 3–8 (бумаги — со 2-го); цель не обязательна ──
+{
+  const S = новая(2);
+  assert.equal(условиеИмени(S, 'предложено'), false, 'на 2-й день у «семьи» письма нет');
+  assert.equal(вСцене(S, ...ОКНО, /Взять запечатанное письмо/), null);
+  const Б = новая(2, 'бумаги');
+  assert.equal(условиеИмени(Б, 'предложено'), true, 'старт с бумагами получает письмо раньше');
+  const П = новая(9);
+  assert.equal(условиеИмени(П, 'предложено'), false, 'после 8-го дня письмо не предлагается');
+  const Д = новая(3);
+  assert.equal(выбратьЦель(Д, 'имя'), true);
+  assert.ok(действияЦелей(новая(3)).some(а => а.id === 'цель:выбрать:имя'), 'цель «Имя» теперь предлагается');
+}
