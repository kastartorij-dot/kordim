+}
+
+// ── 12. Заём у Орша: один открытый, возврат с комиссией; итог «ценой обязательства» ──
+{
+  const S = новая(4, 300);
+  угол(S).услышал = true;
+  выполнитьУгол(S, 'подписать');
+  S.мир.район = 'торговый';
+  войти(S, 'меняльная');
