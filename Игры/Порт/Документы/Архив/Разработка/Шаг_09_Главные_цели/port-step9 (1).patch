+// «Вытащить» (шаг 9 плана): выбранная работница «Синего часа» сама решает, нужна ли ей помощь и какая.
+// Здесь только данные и тексты; правила — Движок/вытащить.js. Источник: документы/материалы-ИИ/задания-и-результаты/
+// шаг-1/Четыре_цели_первого_сезона.md, карточка «Вытащить» и «дружба достаточна».
+//
+// Принципы карточки, которые держит весь модуль: деньги не покупают свободу и не поднимают доверие; цель не
+// «спасти», а дать человеку настоящий выбор; успех — только исход, подтверждённый самим человеком.
+// Выбранная работница — параметр: движок работает с любой записью в РАБОТНИЦЫ, у которой есть ВСЕ поля
+// (это проверяет тест). Сейчас записана одна — Фрея (пилот, «порядок производства» из плана).
+// Ола и Ния не записаны сознательно: у Олы возраст в каноне прямо не назван, а Ния по действующей ветке
+// выплатила долг и остаётся по своей воле («текущий текст не даёт основания снова делать Нию должницей»).
+// Тексты и мотивы Фреи опираются на то, что уже есть в игре (окно в синий час, Сиб, цветок по очереди,
+// шитьё для дома напротив); всё сверх этого — игровые предложения шага 9, не канон мира.
+
+export const ВЫТАЩИТЬ = {
+  доступ: 2,                  // расположение, с которого Фрея выходит поговорить на площадку
+  причиныДни: [6, 24],        // частные разговоры; «в 6–15» из карточки смягчено: пропуск переносится, а не теряется
+  ярнаДо: 21,                 // просьба Ярны
+  ярнаСрок: 3,                // дней на то, чтобы передать слово обеим сторонам
+  планДни: [14, 24],          // первое место после дома
+  ответДни: [24, 29],         // решение самой работницы
+  ожидание: { навязал: 2, отошёл: 1 }, // сколько дней она не станет об этом говорить
+};
+
+export const РАБОТНИЦЫ = {
+  freya: {
+    имя: 'Фрея',
+    падежи: { род: 'Фреи', дат: 'Фрее', вин: 'Фрею' }, // «доверие Фреи», «обещал Фрее», «не расспрашивает Фрею»
+    комната: 'ploshchadka',
+    желание: 'Не «выйти отсюда», а иметь своё окно и свой день: шитьё, подушку на подоконнике и право вставать, когда сама решит.',
+    причины: ['сиб', 'цветок', 'шитьё'],
+    опоры: ['часовня', 'работа'],
+    // Пороги исходов (в расположении 0–4 и числе подтверждённых причин). Расположение — то, что Фрея
+    // думает об Одвине; рычаг (слово Ярне против неё самой) его роняет.
+    правила: { сОдвином: { доверие: 4, причин: 2 }, одна: { доверие: 2 }, безДоверия: 1 },
+  },
+};
+
+// ── Тексты Фреи ──────────────────────────────────────────────────────────────
+export const ТЕКСТЫ = {
+  freya: {
+    слушать: 'Фрея не сразу отвечает. Она смотрит на двор, где темнеет поленница.\n\n— Спрашиваешь не «как тебе здесь», а чего я хочу. Никто так не спрашивал.\n\nОна подбирает под себя ногу.\n\n— Я не хочу, чтобы меня выводили. Я хочу окно, которое моё, шитьё, за которое платят мне, и чтобы никто не решал за меня, когда мне вставать. Если это можно устроить — хорошо. Если нет — я не умру.',
