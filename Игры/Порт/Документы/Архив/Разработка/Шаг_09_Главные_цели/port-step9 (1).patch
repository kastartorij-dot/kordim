+  assert.equal(S.герой.кошель, до, 'расторжение денег не возвращает и не списывает');
+  assert.equal(угол(S).статус, 'расторгнут');
+  assert.equal(угол(S).расторгнут.причина, 'отказ');
+  assert.equal(угол(S).долг, 0);
+  assert.equal(исходУгла(S), 'расторг-сам');
+}
+
+// ── 14. Ночлег и сундук: комната работает как жильё по договору ───────────────
+{
+  const S = новая(3, 300);
+  S.мир.отрезок = 'ночь';
