+  ищи(S, /Занять 30 грошей/).выполнить(S);
+  assert.equal(S.герой.кошель, до + 30);
+  assert.equal(S.мир.места.меняльная.долг, 36);
+  assert.equal(ищи(S, /Занять 30 грошей/), undefined, 'второй заём не открыть');
+  вернутьсяВГород(S);
+  for (const d of ДОГОВОР.сроки) { доДня(S, d); выполнитьУгол(S, 'платёж-взнос'); }
+  assert.equal(исходУгла(S), 'ценой-обязательства');
+  доДня(S, ДЕНЬ_ФИНАЛА);
+  S.мир.отрезок = 'ночь'; лечьСпать(S, null);
+  assert.equal(S.мир.конецДня.финал.исход, 'ценой-обязательства');
+  assert.ok(S.мир.конецДня.финал.строки.some(с => с.includes('Заём у Орша: 36')));
+}
+
+// ── 13. Расторжение по желанию: честный остаток ────────────────────────────────
