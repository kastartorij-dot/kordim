+  доДня(S, 21); конецДня(S); // 21 пропущен: долг 40
+  доДня(S, 28); конецДня(S); // 28: второй подряд
+  assert.equal(угол(S).статус, 'расторгнут');
+  assert.equal(S.мир.день, 29);
+}
+
+// ── 10. Платёж «долг + взнос»: старый долг первым, общая сумма видна заранее ────
+{
+  const S = новая(3, 600);
+  угол(S).услышал = true;
+  выполнитьУгол(S, 'подписать');
+  доДня(S, 7); конецДня(S); // долг 40
+  доДня(S, 14);
+  assert.equal(стоимостьУгла(S, 'платёж-всё'), 70);
+  assert.equal(стоимостьУгла(S, 'платёж-долг'), 40);
+  assert.equal(условиеУглаВ(S, 'платёж-взнос'), false, 'при долге взнос отдельно не платится');
+  const до = S.герой.кошель;
+  assert.equal(выполнитьУгол(S, 'платёж-всё'), true);
+  assert.equal(до - S.герой.кошель, 70);
+  assert.equal(угол(S).долг, 0);
+  assert.equal(угол(S).взносы[14], 'оплачен');
+  assert.equal(угол(S).взносы[7], 'оплачен');
+}
+import { условиеУгла as условиеУглаВ } from '../Движок/угол.js';
+
+// ── 11. Сцена: платёж через меняльную с динамической ценой ─────────────────────
+{
+  const S = новая(3, 600);
+  угол(S).услышал = true;
+  выполнитьУгол(S, 'подписать');
+  доДня(S, 7); конецДня(S); // долг 40
+  доДня(S, 13);
+  S.мир.район = 'торговый';
+  войти(S, 'меняльная');
+  assert.equal(ищи(S, /Внести взнос за комнату/), undefined, 'при долге одиночный взнос скрыт');
+  const всё = ищи(S, /Закрыть долг и внести взнос/);
+  assert.ok(всё, 'в окне виден платёж «всё»');
+  const до = S.герой.кошель;
+  всё.выполнить(S);
+  assert.equal(до - S.герой.кошель, 70, 'сцена списала ровно 70');
+  assert.equal(угол(S).долг, 0);
