     rest_dorr: { ni_o_chem: '— Дело изложи коротко. В доках длинные речи хуже плохих весов.', gore: '— Бренн умел считать. Этого у него не отнимали.' },
@@ -135,14 +150,43 @@ export const МЕНЯЛЬНАЯ = точка('меняльная', 'Меняль
     'окно-меняльной': комната('Окно меняльной', 'За решёткой слышен скрип пера. Здесь хранят и монеты, и обещания.', ['orsh'], [
       деталь('ячейки', 'Ряд ячеек', 'Ячейка №17 закрыта. На ярлыке стоит фамилия Скарре, но её содержимое пока неизвестно.', { свидетельство: 'brenn_cell17_label' }),
       деталь('книга', 'Книгу платежей', 'Каждый платёж оставляет строку; без номера договора нельзя узнать, за что он сделан.'),
+      деталь('объявление-комнаты', 'Объявление о свободной комнате', 'Лист прибит у окна: «Сдаётся комната над меняльной. Договор — у мастера Орша. Задаток шестьдесят, дальше по тридцати в расчётные дни».', { условие: { деньОт: 3 }, угол: 'услышал' }),
     ], ['коридор-меняльной'], [
       действие('Положить 10 грошей на свой счёт', 'Орш считает монеты и записывает вклад на твоё имя. Забрать его можно в этом же окне.', 1, { стоит: 10, эффект: { вклад: 10 } }),
       действие('Снять 10 грошей со своего счёта', 'Орш сверяет имя в книге и отсчитывает тебе десять грошей.', 1, { условие: { вкладОт: 10 }, эффект: { снятьВклад: 10 } }),
-      действие('Взять выписку о ячейке №17', 'Орш выдаёт выписку: в ячейке числятся 41 грош и квитанция. Сумма есть в записи, но деньги не лежат у тебя в кошеле.', 1, { стоит: 2, условие: { безСвидетельства: 'brenn_cell17' }, эффект: { свидетельство: 'brenn_cell17', предмет: 'выписка-17' } }), уйти(),
+      действие('Взять выписку о ячейке №17', 'Орш выдаёт выписку: в ячейке числятся 41 грош и квитанция. Сумма есть в записи, но деньги не лежат у тебя в кошеле.', 1, { стоит: 2, условие: { безСвидетельства: 'brenn_cell17' }, эффект: { свидетельство: 'brenn_cell17', предмет: 'выписка-17' } }),
+      // «Свой угол» (шаг 9). Цены и подписи считает Движок/угол.js; здесь только тексты и условия.
+      действие('Спросить Орша о свободной комнате', 'Орш не поднимает головы от книги. — Над нами пустует комната: кровать, стол, сундук с замком, окно во двор. Сдаю по договору: задаток шестьдесят, потом по тридцати в расчётные дни — седьмой, четырнадцатый, двадцать первый, двадцать восьмой. Весь договор — сто восемьдесят; ночлег и сундук внутри цены. Подписать можно до конца четырнадцатого дня. Посмотреть комнату можно даром.', 0, { условие: { деньОт: 3, деньДо: 14, угол: 'услышать' }, эффект: { угол: 'услышал' } }),
+      действие('Подписать договор комнаты', 'Орш вписывает твоё имя в книгу, отсчитывает ключ и кладёт его на стол. — Взносы не забывай. Платят здесь, в окне, утром или днём.', 1, { условие: { угол: 'подписать' }, эффект: { угол: 'подписать' } }),
+      действие('Закрыть только долг по комнате', 'Орш сверяет сумму с книгой и вычёркивает долг. Строка остаётся — с пометкой «закрыто».', 1, { условие: { угол: 'платёж-долг' }, эффект: { угол: 'платёж-долг' } }),
+      действие('Закрыть долг и внести взнос', 'Орш сначала вычёркивает старую строку, потом пишет новую. — Так вернее, — говорит он, не поднимая глаз.', 1, { условие: { угол: 'платёж-всё' }, эффект: { угол: 'платёж-всё' } }),
+      действие('Внести взнос за комнату', 'Орш отмечает взнос в книге и возвращает тебе перо, которым ты расписался.', 1, { условие: { угол: 'платёж-взнос' }, эффект: { угол: 'платёж-взнос' } }),
+      действие('Расторгнуть договор комнаты', 'Орш молча записывает расторжение и открывает сундук: вещи можно забрать. — Внесённое остаётся в книге, — говорит он. — Но и новых взносов за тобой нет.', 0, { условие: { угол: 'расторгнуть' }, эффект: { угол: 'расторгнуть' } }),
+      действие('Спросить, не освободилась ли комната', 'Орш качает головой. — Договор на эту комнату больше не заключаю: срок вышел. Снимай у вдовы или ищи другую крышу.', 0, { условие: { угол: 'позднее' } }),
+      // Заём: один открытый, возврат с комиссией. Долг живёт в памяти места («Долги» в журнале).
+      действие('Занять 30 грошей у Орша (вернуть 36)', 'Орш записывает сумму и срок без слов. — Тридцать сейчас, тридцать шесть потом. Остальное — арифметика.', 1, { условие: { деньОт: 3, безДолга: true }, эффект: { гроши: 30, долг: 36 } }),
