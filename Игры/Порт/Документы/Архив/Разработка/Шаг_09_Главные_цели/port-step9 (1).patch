+}
+const УНА = S => вМесте(S, 'часовня', 'неф-часовни', 'маяк');
+const ТОББ = S => вМесте(S, 'контора-дорров', 'приёмная-дорров', 'доки');
+const ОРШ = S => вМесте(S, 'меняльная', 'окно-меняльной', 'торговый');
+
+// Быстрые состояния для проверок поздних событий (сами события пройдены ниже по сценам).
