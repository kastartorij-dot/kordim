   ...ЭКРАН_ДОМА,
@@ -112,6 +116,14 @@ export const КОНТОРА_ДОРРОВ = точка('контора-дорро
       действие('Оформить запись по книге', 'Тобб вносит платёж в книгу и выдаёт квитанцию. Запись остаётся в конторе.', 1, { стоит: 6, условие: { разВДень: 'по-книге' }, эффект: { предмет: 'квитанция', разВДень: 'по-книге' } }),
       действие('Передать пошлину по руке', 'Монета исчезает под книгой. Квитанции не будет; Тобб запоминает твоё лицо.', 1, { стоит: 4, условие: { разВДень: 'по-руке' }, эффект: { очки: { ножи: 1 }, тень: 1, разВДень: 'по-руке' } }), уйти(),
       действие('Помочь Тоббу при ревизии', 'Ты придерживаешь книги, пока Тобб собирает бумаги в сундук. Он оставляет запись о твоей помощи.', 1, { условие: { деньОт: 12, деньДо: 12, разВДень: 'ревизия' }, эффект: { очки: { репутация: 1 }, разВДень: 'ревизия' } }),
+      // «Имя» (шаг 9): письмо Нотариуса. Осмотр бесплатный; вскрытие оставляет след и необратимо.
+      действие('Осмотреть печать и внешние признаки письма', 'Ты читаешь бумагу глазами, как читают чужие накладные: воск лёг ровно, оттиск свежий, но края конверта подклеены дважды. Кто-то уже думал, что письму стоит дойти нетронутым. Внутрь ты не заглянул.', 0, { условие: { имяЦели: 'осмотр', начало: 'бумаги' }, эффект: { имяЦели: 'осмотр' } }),
+      действие('Осмотреть печать и внешние признаки письма', 'Ты взвешиваешь письмо на ладони: легче, чем должно быть при такой печати, а воск поставлен как для тяжёлого груза. Внутри меньше, чем обещано снаружи. Читать ты не стал.', 0, { условие: { имяЦели: 'осмотр', начало: 'семья' }, эффект: { имяЦели: 'осмотр' } }),
+      действие('Осмотреть печать и внешние признаки письма', 'Ты замечаешь на конверте угловатый знак, который знаком тебе по чужой коже. Люди, которых он отмечает, не любят, когда о них пишут через третьих. Письму опасно доходить до Дорра как есть. Читать ты не стал.', 0, { условие: { имяЦели: 'осмотр', начало: 'наколки' }, эффект: { имяЦели: 'осмотр' } }),
+      действие('Оставить письмо у Тобба для Дорра', 'Тобб поворачивает конверт к свету, кивает на печать и вносит в книгу: «принято нераспечатанным». Он не спрашивает, что внутри. Это не его дело и не твоё.', 1, { условие: { имяЦели: 'доставить' }, эффект: { имяЦели: 'доставить' } }),
+      действие('Вскрыть печать самому', 'Воск трескается с тихим щелчком. Внутри три строки без подписи: «Люди Дорра взвешивают дважды: раз для картеля, раз для себя. Спроси его, куда уходит разница». Письмо написано, чтобы Дорр решил, что картель следит за его весами. Печать уже не склеить.', 1, { подпись: 'след останется', условие: { имяЦели: 'вскрыть' }, эффект: { имяЦели: 'вскрыть' } }),
+      действие('Подтвердить для Дорра запись о судне', 'Тобб просит помочь с ревизией: сверить, что записано в книге, а что принесли на руке. Ты записываешь только то, что видел сам, и подписываешь это своим именем.', 2, { условие: { имяЦели: 'служба-ножи' }, эффект: { имяЦели: 'служба-ножи' } }),
+      действие('Передать Тоббу слово Ярны', ФР.ярнаНожи, 1, { условие: { вытащить: 'ярна-ножи' }, эффект: { вытащить: 'ярна-ножи' } }),
     ], фон('rgba(120,153,180,.22)', '#1a2730')),
     'весовая-дорров': комната('Доковая весовая', 'На большом столе лежит книга грузов. Рядом другой весовщик настраивает рабочие гири.', [], [
       деталь('запись', 'Старую запись Бренна', 'На странице Бренн написал: «не подпишу — вес не сходится». Позднейшая печать говорит «принято по руке». Кто поставил печать и что стало с карьерой Бренна, эта запись одна не доказывает.', { свидетельство: 'brenn_office_entry' }),
@@ -119,7 +131,10 @@ export const КОНТОРА_ДОРРОВ = точка('контора-дорро
     ], ['приёмная-дорров'], [], фон('rgba(164,162,135,.17)', '#23241f')),
     'кабинет-дорров': комната('Кабинет смотрителя', 'У стола два стула и две чернильницы. Одно место выглядит только что оставленным.', ['rest_dorr'], [
       деталь('стулья', 'Стулья и чернильницы', 'Для одного человека здесь приготовлено слишком много одинаковых вещей. Это намёк, а не доказательство личности сидевшего.'),
-    ], ['приёмная-дорров'], [], фон('rgba(148,125,110,.22)', '#241c1c')),
+    ], ['приёмная-дорров'], [
+      действие('Передать письмо Дорру и попросить вскрыть при тебе', 'Дорр берёт конверт, ломает печать и читает вслух, не глядя на тебя: подначка, рассчитанная стравить его с картелем. Он усмехается. — Принёс честно. Вот десять — и запомню, что ты не стал читать за моей спиной.', 1, { условие: { имяЦели: 'разрешение' }, эффект: { имяЦели: 'разрешение' } }),
+      действие('Предупредить Дорра о письме, не передавая его', 'Дорр слушает, не перебивая. — Письмо у тебя, слово у меня. Донеси своё: сначала то, чем ты поручился, потом то, чем рискуешь.', 1, { условие: { имяЦели: 'предупредить' }, эффект: { имяЦели: 'предупредить' } }),
+    ], фон('rgba(148,125,110,.22)', '#241c1c')),
