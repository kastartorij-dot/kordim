+// без состояния и без DOM. Источник правил: Документы/Разработка/Шаг_01_История_и_правила/Четыре_цели_первого_сезона.md.
+// Числа договора — игровые параметры для проверки балансом, не факты канона.
+
+export const ДЕНЬ_ВЫБОРА = 3; // с этого дня журнал предлагает направление
+export const ДЕНЬ_ФИНАЛА = 30;
+
+// «готова» — цель можно выбрать в журнале. Цели без полного содержания не предлагаются:
+// неполные цели промежуточной сборки не объявляются готовыми (ПЛАН П09.4).
+export const ЦЕЛИ = {
+  угол: {
+    id: 'угол', имя: 'Свой угол', готова: true,
+    кратко: 'Комната, договор и право на неё к тридцатому дню.',
+  },
+  имя: { id: 'имя', имя: 'Имя', готова: true, кратко: 'Стать независимым посредником или человеком одной стороны.' },
+  вытащить: { id: 'вытащить', имя: 'Вытащить', готова: true, кратко: 'Помочь человеку из «Синего часа» сделать собственный выбор.' },
+  уехать: { id: 'уехать', имя: 'Уехать', готова: false, кратко: 'Выбрать путь из города и добраться до отплытия.' },
+};
+
+// «Свой угол»: 60 + 4 × 30 = 180 грошей. Ночлег и сундук после подписи входят в цену.
+export const ДОГОВОР = {
+  задаток: 60,
+  взнос: 30,
+  сбор: 10,            // один раз за первый пропуск действующего договора
+  сроки: [7, 14, 21, 28],
+  первыйДень: 3,       // договор предлагается с 3-го дня
+  последняяПодпись: 14,
+  заранеЗа: 3,         // взнос можно внести не раньше чем за три дня до срока (решение реализации)
+};
+
+// Что платится при подписи в данный день.
+//  3–6:  60;  7: 60 при подписи + 30 до конца дня;  8–13: 90;  14: 120 (оба наступивших взноса сразу).
