+// ── 7. Переговоры с Ярной: одна попытка, четыре способа ──────────────────────────────
+const переговоры = (S, шаблон) => { вКабинет(S); return { а: ищи(S, шаблон), S }; };
+{
+  // условия открытия: обещание + хотя бы одна причина (или уважённая граница)
+  const А = новая(20); обещание(А); А.мир.цели.зафиксирована = true; вКабинет(А);
+  assert.equal(ищи(А, /Прийти к Ярне вместе с Фреей/), null, 'без причин разговора нет');
+  в(А).причины.push('сиб'); вКабинет(А);
+  assert.ok(ищи(А, /Прийти к Ярне вместе с Фреей/));
+  assert.equal(ищи(А, /Напомнить Ярне/), null, 'долг есть только после слова Ярны');
+  assert.equal(ищи(А, /двух плательщиках/), null, 'рычаг только из услышанного самой Ярной');
+  assert.ok(ищи(А, /Попросить без рычага и без долга/));
+  assert.ok(ищи(А, /Не начинать этот разговор/));
+  // отступить не тратит единственную попытку
+  нажми(А, /Не начинать этот разговор/);
+  assert.equal(в(А).переговоры, null);
+  вКабинет(А); assert.ok(ищи(А, /Прийти к Ярне вместе с Фреей/), 'попытка осталась');
+}
