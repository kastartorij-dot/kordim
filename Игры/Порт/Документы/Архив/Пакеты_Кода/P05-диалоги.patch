diff --git a/wiki/game/port/данные/голоса.js b/wiki/game/port/данные/голоса.js
new file mode 100644
index 0000000..d8d3c81
--- /dev/null
+++ b/wiki/game/port/данные/голоса.js
@@ -0,0 +1,28 @@
+// Девять голосов (ПЛАН_ДОРАБОТКИ П05.5, концепт диалогов §3): БРЮХО, КОСТИ, ХМЕЛЬ, ЖАР, голос ремесла (МЕРА, СТРОКА или ИГЛА — один, по стартовому ремеслу), МОЛВА, ЧУТЬЁ, ОТЕЦ, ДЫМ. Новых шкал нет: голос читает то, что уже лежит в S.герой и S.мир.
+// группа: нужды (громкость 0–3 = состояние), ум и прошлое (ступень 0–3). цвет — для ленты.
+export const ГОЛОСА = {
+  БРЮХО: { группа: 'нужды', цвет: '#c9a45a', кто: 'Грубоватый практик, считает еду в грошах.' },
+  КОСТИ: { группа: 'нужды', цвет: '#8fa3b5', кто: 'Ворчливый и честный: ноги, спина, сырость.' },
+  ХМЕЛЬ: { группа: 'нужды', цвет: '#7fb069', кто: 'Добрый обаятельный лгун: «на минутку».' },
+  ЖАР: { группа: 'нужды', цвет: '#e08aa0', кто: 'Прямой и насмешливый, всегда за короткий путь.' },
+  МЕРА: { группа: 'ум', цвет: '#e8d9a0', ремесло: 'грузчик', кто: 'Глаз на вес: вес, вещи, силы человека.' },
+  СТРОКА: { группа: 'ум', цвет: '#e8d9a0', ремесло: 'грамота', кто: 'Бумаги, мелкий шрифт, долги на бумаге.' },
+  ИГЛА: { группа: 'ум', цвет: '#e8d9a0', ремесло: 'наколки', кто: 'Кожа, чужая биография, руки.' },
+  МОЛВА: { группа: 'ум', цвет: '#6f8fd0', кто: 'Сплетница: «говорят», «слышала». Иногда путает.' },
+  ЧУТЬЁ: { группа: 'ум', цвет: '#a07fd0', кто: 'Сухое и подозрительное: «не оборачивайся».' },
+  ОТЕЦ: { группа: 'прошлое', цвет: '#f1ece0', кто: 'Бренн Скарре, весовщик. Не ругает — молчит.' },
+  ДЫМ: { группа: 'прошлое', цвет: '#9a9a9a', кто: 'Тихий и липкий: советует врать, молчать, уходить.' },
+};
+
+// Голоса ремесла делят один слот: у героя звучит тот, чьё ремесло было стартовым (грузчик → МЕРА, грамота → СТРОКА, наколки → ИГЛА).
+export const ГОЛОСА_РЕМЕСЛА = ['МЕРА', 'СТРОКА', 'ИГЛА'];
+export const СТУПЕНИ_РЕМЕСЛА = { 'умеешь': 1, 'набил руку': 2, 'мастер': 3 };
+
+// Зарубки → ступень (как у фракций): 3 / 8 / 15.
+export const ЗАРУБКИ_ПОРОГИ = [[15, 3], [8, 2], [3, 1], [0, 0]];
+// Подтверждённые темы → ступень МОЛВЫ: 0–2 → 0, 3–5 → 1, 6–9 → 2, 10+ → 3.
+export const МОЛВА_ПОРОГИ = [[10, 3], [6, 2], [3, 1], [0, 0]];
+
+// Сколько узлов голос молчит после своей строки; сколько голосов на экран.
+export const ГОЛОС_МОЛЧИТ_УЗЛОВ = 2;
+export const ГОЛОСОВ_НА_УЗЕЛ = 2;
diff --git a/wiki/game/port/данные/диалоги/сиб.js b/wiki/game/port/данные/диалоги/сиб.js
new file mode 100644
index 0000000..dea12fd
--- /dev/null
+++ b/wiki/game/port/данные/диалоги/сиб.js
@@ -0,0 +1,342 @@
+// Сиб — первый законченный человек в формате графа (ПЛАН_ДОРАБОТКИ П05.8, концепт диалогов §10).
+// У Сиба один замок («прямота»), одна старая рана, три полосы на запястье. Формат читает движок/диалог.js.
+//
+// Условия узла: сыт/отдых/тепло/цел [от, до], тень, флаг, факт, доверие, предмет, голос, визитовОт/До, обязательство, любое/не.
+// Строка «— …» — речь Сиба, остальное — рассказчик; { видят: true } — место для строки «видят».
+// Вариант: { ид, текст, эхо?, если?, стоит?, стоитЕщё?, манера?, проверка?, эффект?, ответ?, голоса?, дальше?, закреплён? };
+//          у проверки свои успех/провал: { ответ, голоса, эффект, дальше, исход }.
+//
+// Хронология (исправлена): Одвин семь лет ходил по баржам; Сиб «четвёртый год» у дома, до этого — на барже. Узел под полосами
+// бит Одвином пять лет назад на барже за полторы марки (не «год назад у пристани»: Одвина здесь тогда не было). Полосы — по одной
+// в год у дома (три полные + четвёртый идёт). Колено: мешок соли на сходне, шесть лет назад, правое. Эта правда не меняется от кубика.
+
+const ЗАКРЫТЬ = 'закрыть';
+
+export const ДИАЛОГ_СИБ = {
+  человек: 'sib',
+  имя: 'Сиб',
+  дверь: 'вход',
+  вступление: 'Он поворачивает к тебе голову, не меняя позы. Ждёт.',
+  снова: 'Он стоит там же, где стоял. Узнаёт тебя по шагу, не по лицу.',
+
+  // Что человек замечает по герою (одна строка, первая подошедшая).
+  видят: [
+    { если: { сыт: [0, 1] }, т: 'Взгляд задерживается на твоих руках — на том, как ты держишь сумку. Крепко. Как держат последнее.' },
+    { если: { тепло: [0, 1] }, т: 'Он смотрит на твои пальцы — синие, одеревеневшие, — и отводит глаза. Такое он видел.' },
+    { если: { цел: [0, 1] }, т: 'Он замечает, как ты ставишь ногу, и ничего не говорит.' },
+    { если: { отдых: [0, 1] }, т: 'Ты моргаешь дольше, чем нужно. Он это видит и не торопит.' },
+  ],
+
+  хаб: ['давно', 'колено', 'правила', 'наколки', 'хозяйка', 'долги', 'деньги', 'поздно'],
+
+  ветки: {
+    // ── вход: у двери, ходы не тратятся ─────────────────────────────────
+    вход: {
+      ярлык: 'у двери', ходы: 0, толькоУДвери: true, засчитывать: false,
+      узлы: {
+        старт: {
+          текст: [
+            { если: { визитовДо: 2 }, т: 'В дверях стоит человек, широкий, как створка. Он не загораживает вход — просто стоит так, что мимо не пройти.' },
+            { если: { визитовДо: 2 }, т: 'Он поворачивает к тебе голову, не меняя позы. Ждёт.' },
+            { если: { визитовОт: 2 }, т: 'Он стоит там же, где стоял.' },
+            { видят: true },
+            { если: { обязательство: { ид: 'сиб:зайти', статус: 'открыто' } }, т: '— Зашёл. Ты обещал заглянуть, я помню.' },
+            { если: { обязательство: { ид: 'сиб:зайти', статус: 'истекло' } }, т: '— Три дня, как обещал, — говорит он без укора. — Ладно.' },
+            { если: { предмет: 'нож' }, т: '— Оружие на стол. Двадцать грошей за вход, вино отдельно.' },
+            { если: { безПредмета: 'нож' }, т: '— Двадцать. Вперёд. Внутри не бьют и не торгуются.' },
+          ],
+          при: [
+            { если: { обязательство: { ид: 'сиб:зайти', статус: 'открыто' } }, э: { выполнено: 'сиб:зайти', распол: { sib: 1 } } },
+            { если: { обязательство: { ид: 'сиб:зайти', статус: 'истекло' } }, э: { распол: { sib: -1 }, один: 'обещание-не-выполнено' } },
+          ],
+          голоса: [
+            { ид: 'мера', голос: 'МЕРА', проверка: { порог: 'средне' },
+              т: 'Пудов шесть, если по-нашему. Стоит на левой, правую бережёт. Такого не сдвинешь и не перекричишь — только объяснишь, и то коротко.' },
+            { ид: 'игла', голос: 'ИГЛА', проверка: { порог: 'лёгко' },
+              т: 'Три чёрные полосы на запястье и узел под ними. Узел бит иначе, чем полосы: левой рукой. Ты знаешь эту руку.' },
+            { ид: 'брюхо', голос: 'БРЮХО', если: { сыт: [0, 1] },
+              т: 'Из-за двери тянет жареным луком. Двадцать грошей — две миски похлёбки и хлеб. Просто арифметика.' },
+            { ид: 'чутьё', голос: 'ЧУТЬЁ', если: { тень: [1, 3] },
+              т: 'У соседнего фонаря двое. Один смотрел на кошелёк, не на тебя.' },
+          ],
+          варианты: [
+            { ид: 'платить', текст: '«Держи. Двадцать.»', если: { безПредмета: 'нож', деньгиОт: 20 }, стоит: 20,
+              эффект: { гроши: -20, вошёл: true }, дальше: 'пустой' },
+            { ид: 'сдать', текст: 'Выложить нож на доску и отсчитать двадцать грошей.', если: { предмет: 'нож', деньгиОт: 20 }, стоит: 20,
+              эффект: { гроши: -20, вошёл: true, сдатьОружие: 'нож', флаг: 'сдал_нож', распол: { sib: 1 }, дом: 1 }, дальше: 'сдал' },
+            { ид: 'спрятать', текст: '«Двадцать. Оружия нет.»', если: { предмет: 'нож', деньгиОт: 40 }, стоит: 20, стоитЕщё: 20,
+              проверка: { голос: 'ДЫМ', порог: 'трудно', тип: 'красная', факты: [{ вид: 4, что: 'опрятный вид' }] },
+              успех: {
+                эффект: { гроши: -20, вошёл: true, флаг: 'тайно_с_ножом' },
+                ответ: ['Он берёт двадцать, кивает и пропускает. Взгляд скользит по складкам твоей куртки и не задерживается.', '— Не шуми там.'],
+                голоса: [{ голос: 'ДЫМ', ид: 'ложь-ок', т: 'Откуда нож? Нет ножа. Всегда не было. Остальное сгорело.' }],
+                дальше: 'тайно',
+              },
+              провал: {
+                эффект: { гроши: -40, вошёл: true, сдатьОружие: 'нож', флаг: 'сдал_нож', дом: -2, тень: 1, факт: 'попался_с_ножом' },
+                ответ: ['Тяжёлая ладонь ложится тебе на плечо раньше, чем рука отходит от пояса. Он достаёт нож из-за голенища двумя пальцами, как достают занозу.', '— Врать на пороге. Я предупреждал.'],
+                голоса: [{ голос: 'ЧУТЬЁ', ид: 'ложь-плохо', т: 'Теперь о тебе знают двое: он и тот, кто слышал, как он это сказал.' }],
+                дальше: 'попался',
+              } },
+            { ид: 'давно', текст: '«Давно тут стоишь?»', дальше: { ветка: 'давно' } },
+            { ид: 'правила', текст: '«Какие тут правила?»', дальше: { ветка: 'правила' } },
+            { ид: 'уйти', текст: 'Развернуться и уйти.', закреплён: true, эффект: { финал: 'несмог' } },
+          ],
+        },
+        пустой: {
+          текст: ['— Пусто? Ну и хорошо.', 'Он отходит на полшага, освобождая дверь.', '— Заходи. Внутри теплее, чем снаружи, это я гарантирую. Остальное — как сам справишься.'],
+          варианты: [{ ид: 'войти', текст: 'Войти.', дальше: ЗАКРЫТЬ }],
+        },
+        сдал: {
+          текст: ['Он принимает нож двумя руками, как принимают что-то живое, и убирает в ящик.', '— До утра тут полежит. На выходе — твой. Заходи.'],
+          варианты: [{ ид: 'войти', текст: 'Войти.', дальше: ЗАКРЫТЬ }],
+        },
+        тайно: {
+          текст: ['Ты чувствуешь его взгляд между лопатками до самой лестницы. Не оборачиваешься.'],
+          варианты: [{ ид: 'войти', текст: 'Войти.', дальше: ЗАКРЫТЬ }],
+        },
+        попался: {
+          текст: ['— Сорок. Нож в ящике, до утра. Хочешь спорить — говори со мной, а не с дверью.'],
+          варианты: [{ ид: 'войти', текст: 'Молча войти.', дальше: ЗАКРЫТЬ }],
+        },
+      },
+    },
+
+    // ── давно: «тут не врут про то, за что платят» ────────────────────────
+    давно: {
+      ярлык: 'сколько ты здесь', реплика: '«Давно тут стоишь?»', ходы: 1, первая: true, манера: 'прямо',
