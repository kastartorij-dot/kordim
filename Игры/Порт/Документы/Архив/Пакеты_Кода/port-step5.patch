+// Колода «Подсобить в бане» (трущобы, утро/день/вечер). Место, где «без одежды нет чинов». Работа даёт тепло и чистый вид.
+// Нить «Как падать»: Старый боец учит кулаку — но только тех, с кем уже говорили в бане (распол ≥ 1, диалоговое место).
 export const КОЛОДА = [
-  { id: 'баня_вода', вес: 4, текст: 'Вода, дрова и лавки. К полудню всё блестит.', эффект: { тело: { тепло: 1 } } },
+  // ── обычные смены ────────────────────────────────────────────────────
+  {
+    id: 'banya_par', вес: 3,
+    текст: 'Плеснуть воды на камни, натаскать дров, вымыть лавки. К полудню руки красные, зато мёрзнуть некогда и не хочется. Банщик на тебя не смотрит — значит, работа идёт как надо.',
+  },
+  {
+    id: 'banya_pyanyj', вес: 2,
