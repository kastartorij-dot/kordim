+// «Круг» — кулачные бои у Братства (трущобы, вечер). Не работа за смену, а ставка: платит исход, не время (ГДД §14).
+// Кошелёк — что дадут за победу; цена поражения — цел. Тяжёлый соперник — только в нечётные дни (Горм не ведёт дел
+// в чётные, канон) и только тем, кого позвали на круг. Числа — Порт-работы-задание.md, «Проверка балансом».
+export const КОЛОДА = [
+  // случаи-нити на круге
+  {
+    id: 'boj_zovet', нить: true, однажды: true, условие: { счётчик: { победы: { от: 3 } }, нетФлага: 'круг_зван' },
+    текст: 'После третьей победы к тебе подходит человек, которому не нужно говорить громко:\n\n— Горм видит, как ты держишься, — говорит он. — Приходи в нечётный день. Тогда будет соперник посерьёзнее. И расчёт другой.',
+    эффект: { флаг: 'круг_зван', фракции: { братство: 2 } },
+  },
+];
+
+export const БОЙ = {
+  вступление: 'Круг — вытоптанный пятачок между двумя стенами. Ставки принимают у стены, драться выходят по одному. Зрителей больше, чем табуретов, и почти все смотрят в землю — пока кто-нибудь не упадёт.',
+  мод: { ступень: { 0: 0, 1: 0.08, 2: 0.16 }, флаги: { совет_бойца: 0.1 }, сыт1: -0.1, отдых1: -0.1, цел2: -0.05, минимум: 0.1, максимум: 0.85 },
