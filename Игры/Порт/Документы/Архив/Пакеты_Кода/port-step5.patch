+    выбор: [
+      {
+        текст: 'Вытащить самому',
+        эффект: { распол: { banshchik: 1 }, гроши: 1 },
+        итог: 'Ты тащишь его вниз за подмышки. Он мычит про какую-то Марту и обещает, что всё вернёт. Банщик впервые за день поворачивает голову и кивает.',
+      },
+      {
