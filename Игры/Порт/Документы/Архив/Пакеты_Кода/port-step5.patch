+  {
+    id: 'banya_kozha', вес: 2,
+    текст: 'Без рубах видно то, что днём прячут: клеймо каторжника, узел Ножей, старую наколку кораблём. Ты трёшь лавки и читаешь эти биографии, пока они парятся, — чужая кожа рассказывает больше, чем язык.',
+  },
+  {
+    id: 'banya_kozha_masterstvo', вес: 2, условие: { ремесло: { имя: 'наколки' } },
+    текст: 'Кто-то на верхней полке поворачивается, и ты видишь на его лопатке знакомую вязь. Твоя работа, ещё до отъезда. Он тебя не узнаёт. А ты знаешь эту линию лучше собственной подписи.',
+    эффект: { гроши: 2 },
+  },
+
+  // ── нить «Как падать» ────────────────────────────────────────────────
+  {
+    id: 'banya_boec_urok', вес: 7, условие: { безРемесла: 'кулак', распол: { boec: { от: 1 } } },
+    текст: 'Старый боец сидит на нижней лавке, как всегда, и смотрит, как ты таскаешь воду.\n\n— Плечи есть, — говорит он. — Стоять не умеешь. Хочешь — покажу, как падать? Падать — это половина.',
+    выбор: [
+      {
+        текст: 'Согласиться на урок',
+        эффект: { урок: 'кулак', тело: { отдых: -1 } },
+        итог: 'Он показывает, куда смотреть, где держать локти и, главное, куда падать, чтобы встать. Ты падаешь двенадцать раз. Он говорит, что для начала хватит.',
