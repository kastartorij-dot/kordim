+// Шаг 5: полный набор работ перенесён в игру без потерь, и два места движка выдерживают новые данные.
+// Запуск: node Порт/тест/шаг5.mjs
+import assert from 'node:assert/strict';
+import { execFileSync } from 'node:child_process';
+import { readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import { новоеСостояние } from '../движок/состояние.js';
+import { положить } from '../движок/вещи.js';
+import { потратитьОтрезок } from '../движок/время.js';
+import { войти, вернутьсяВГород, времяИдёт } from '../движок/разговор.js';
+import { ВЕЩИ } from '../данные/вещи.js';
+import { РЕЕСТР } from '../данные/темы.js';
+import { ТЕМЫ_РАБОТ } from '../данные/темы-работ.js';
+import { КОЛОДА as РАЗГРУЗКА } from '../данные/смены/разгрузка.js';
+import { КОЛОДА as ВЕСЫ } from '../данные/смены/весы.js';
+import { КОЛОДА as РАЗНОСКА } from '../данные/смены/разноска.js';
+import { КОЛОДА as ЧТЕЦ } from '../данные/смены/чтец.js';
+import { КОЛОДА as БАНЯ } from '../данные/смены/баня.js';
+import { КОЛОДА as КУХНЯ } from '../данные/смены/кухня.js';
+import { КОЛОДА as ОХРАНА } from '../данные/смены/охрана.js';
+import { КОЛОДА as БОЙ_КОЛОДА, БОЙ } from '../данные/смены/бой.js';
+import { КОЛОДА as НАКОЛКИ } from '../данные/смены/наколки.js';
+import { КОЛОДА as МАЯК } from '../данные/смены/маяк.js';
+
+const КОЛОДЫ = { разгрузка: РАЗГРУЗКА, весы: ВЕСЫ, разноска: РАЗНОСКА, чтец: ЧТЕЦ, баня: БАНЯ, кухня: КУХНЯ, охрана: ОХРАНА, бой: БОЙ_КОЛОДА, наколки: НАКОЛКИ, маяк: МАЯК };
+
+// 1. Объём: 80 случаев, из них 26 нитевых, три соперника, пять новых тем.
+{
+  const все = Object.values(КОЛОДЫ).flat();
+  assert.equal(все.length, 80, '80 случаев');
+  assert.equal(все.filter(с => с.нить).length, 26, '26 нитевых');
+  assert.equal(new Set(все.map(с => с.id)).size, 80, 'id случаев не повторяются');
+  assert.equal(БОЙ.соперники.length, 3, 'три соперника на круге');
+  assert.deepEqual(Object.keys(ТЕМЫ_РАБОТ).sort(), ['brenn_vesy', 'kniga_vesov', 'kupec_raspiska', 'otvet_iz_doma', 'vesy_gir'], 'пять новых тем');
+  for (const id of Object.keys(ТЕМЫ_РАБОТ)) assert.ok(РЕЕСТР[id], `тема ${id} доступна в общем реестре`);
+}
+
+// 2. Каждая вещь, которую карточки выдают или требуют, есть в каталоге.
+{
+  const найдены = new Set();
+  const идти = о => {
+    if (Array.isArray(о)) return о.forEach(идти);
+    if (!о || typeof о !== 'object') return;
+    for (const [к, з] of Object.entries(о)) {
+      if (к === 'вещь' || к === 'убратьВещь') найдены.add(з);
+      if (к === 'предмет' || к === 'безПредмета') [].concat(з).forEach(и => найдены.add(и));
+      идти(з);
+    }
+  };
+  идти(Object.values(КОЛОДЫ)); идти(БОЙ);
+  const нет = [...найдены].filter(и => typeof и === 'string' && !ВЕЩИ[и]);
+  assert.deepEqual(нет, [], `вещи из карточек отсутствуют в каталоге: ${нет.join(', ')}`);
+}
+
+// 3. Тексты в игре дословно совпадают с принятым файлом «Порт-работы-тексты.md».
+{
+  const скрипт = fileURLToPath(new URL('./тексты-работ-в-md.mjs', import.meta.url));
+  const образец = fileURLToPath(new URL('../документы/от-другой-ИИ/Порт-работы-тексты.md', import.meta.url));
+  const выгрузка = execFileSync('node', [скрипт], { encoding: 'utf8', maxBuffer: 32 * 1024 * 1024 });
+  assert.equal(выгрузка, readFileSync(образец, 'utf8'), 'выгрузка из игровых данных = Порт-работы-тексты.md');
+}
+
+// 4. Гиря Бренна занимает два места, но не утяжеляет день: «Тяжёлый груз» — только про тюк.
+//    Раньше любая вещь на два места снимала отдых каждый отрезок, и нить о Бренне калечила героя за неделю.
+{
+  const S = новоеСостояние('семья', 12);
+  S.мир.отрезок = 'утро'; S.герой.тело.отдых = 3;
+  assert.equal(положить(S, 'гиря'), true);
+  потратитьОтрезок(S);
+  assert.equal(S.герой.тело.отдых, 3, 'с гирей отдых не падает');
+  assert.equal(S.герой.тело.цел, 3, 'с гирей цел не падает');
+  assert.equal(положить(S, 'груз'), true);
+  потратитьОтрезок(S);
+  assert.equal(S.герой.тело.отдых, 2, 'с тюком груза отдых падает на единицу');
+}
+
+// 5. Итог вечера не падает, если расположение есть у человека без комнаты (старшой, весовщик: их пишут работы).
+{
+  const S = новоеСостояние('семья', 1);
+  S.мир.район = 'торговый'; S.мир.отрезок = 'вечер'; S.герой.кошель = 100;
+  S.мир.люди.starshoj = { спрошено: [], исчерпано: [], распол: 3 };
+  S.мир.люди.ola = { спрошено: [], исчерпано: [], распол: 1 };
+  войти(S, 'синий-час'); времяИдёт(S, 50);
+  assert.ok(S.сцена?.итог, 'итог вечера построен');
+  assert.doesNotThrow(() => вернутьсяВГород(S));
+}
+
+console.log('Шаг 5: 80 случаев, 26 нитей, три соперника и пять тем перенесены; тексты совпадают с принятыми; гиря и люди без комнаты больше не ломают игру.');
