+// Обязательства, сроки и «выдано один раз». Без DOM, без имён — конкретные дела, платежи и просьбы
+// придут из данных позже (П07, П10); здесь только правила, чтобы они не расходились между пакетами.
+//
+// Обязательство: { ид, кому, что, срок, статус, последствие? }
+//   срок: { день, отрезок? } — «до конца этого отрезка»; без отрезка — «до конца дня» (последняя ночь тоже считается);
+//         { визит: 'место' } — «пока не выйдешь из этого места».
+//   статус: 'открыто' → 'выполнено' | 'истекло'. Из закрытого состояния назад дороги нет.
+//   последствие — эффект (движок/эффекты.js), который применяется один раз при истечении срока.
+//
+// Срок «до вечера» допускает последнее действие вечера и кончается на переходе вечер → ночь.
+// Срок «до конца дня» допускает последнее действие ночи и кончается на закрытии дня (ФАЗЫ_КОНЦА_ДНЯ, «обязательства»).
+import { применитьЭффект } from './эффекты.js';
+
+// Порядок совпадает с ОТРЕЗКИ из время.js (тест сверяет). Здесь свой список, чтобы не было круга импортов.
+export const ПОРЯДОК = ['утро', 'день', 'вечер', 'ночь'];
+const ШАГОВ = ПОРЯДОК.length;
+
+// Момент времени числом: сутки × 4 + номер отрезка. «После ночи» = ШАГОВ, то есть уже следующее утро.
+const момент = (день, отрезок) => день * ШАГОВ + (отрезок === undefined ? ШАГОВ - 1 : ПОРЯДОК.indexOf(отрезок));
+
+// ── выдано один раз ─────────────────────────────────────────────────────
+// Награда, платёж, предмет, факт с id выдаются ровно один раз за игру: повторный клик, возврат к старому
+// экрану или загрузка сохранения второй раз с тем же id ничего не выдают. Откат внутри сцены возвращает
+// и сам реестр (он часть S), так что после отката награду можно получить снова — как и должно быть.
+export function выдатьОдин(S, ид) {
+  if (!ид) return true; // без id одноразовости нет — так работают обычные повторяемые действия
+  const в = (S.мир.выдано ??= {});
+  if (ид in в) return false;
+  в[ид] = S.мир.день;
+  return true;
+}
+export const выданоЛи = (S, ид) => !!S.мир.выдано && ид in S.мир.выдано;
