+  return true;
+}
+
+// Закрыть выполненным. true — только в тот раз, когда оно действительно было открыто: награду за дело
+// выдаёт тот, кому вернулось true, и повторить её нельзя.
+export function выполнить(S, ид) {
+  const о = найти(S, ид);
+  if (!о || о.статус !== 'открыто') return false;
+  о.статус = 'выполнено';
+  о.закрыто = S.мир.день;
+  return true;
+}
+
+export const открыто = (S, ид) => найти(S, ид)?.статус === 'открыто';
+
+// Истёк ли срок, если сейчас день/отрезок; повод 'день' — сутки закрываются, часы уже за последним отрезком.
+function истёк(S, о, повод, инфо) {
+  const с = о.срок;
+  if (с.визит) return повод === 'визит' && инфо?.место === с.визит;
+  const сейчас = повод === 'день' ? момент(S.мир.день, undefined) + 1 : момент(S.мир.день, S.мир.отрезок);
+  return момент(с.день, с.отрезок) < сейчас;
+}
+
+// Вызывается на переходах: 'отрезок' (после смены отрезка), 'день' (фаза закрытия суток), 'визит' (выход из места).
+// Возвращает список только что истёкших. Последствие каждого применяется один раз.
+export function проверитьСроки(S, повод, инфо = null) {
+  const истекли = [];
+  for (const о of список(S)) {
+    if (о.статус !== 'открыто' || !истёк(S, о, повод, инфо)) continue;
+    о.статус = 'истекло';
+    о.закрыто = S.мир.день;
+    истекли.push(о);
+    S.мир.журналДня.push(`Срок вышел: ${о.что || о.ид}`);
+    if (о.последствие) применитьЭффект(S, о.последствие, { откуда: `срок:${о.ид}`, источник: 'нить' });
+  }
+  return истекли;
+}
