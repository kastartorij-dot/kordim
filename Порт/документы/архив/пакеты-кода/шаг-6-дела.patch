+import { войти, действияСцены, вернутьсяВГород, назад, платаВхода, видСцены } from '../движок/разговор.js';
+import { доступныеДействия } from '../движок/действия.js';
+import { естьВещь, привестиВещи, положить, можноПоложить, вскрытьВещь, действияВещей } from '../движок/вещи.js';
