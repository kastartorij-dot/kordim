+// Шаг 6: дела жителей. Каждое из десяти дел проходит через тот же интерфейс, что и игра:
+// кнопки сцены (доска, разговор), городские действия (сдача), конец дня (сроки и потери), журнал.
+import assert from 'node:assert/strict';
+import { ДЕЛА, ИДЫ_ДЕЛ } from '../данные/дела.js';
+import { МЕСТА } from '../данные/места.js';
